CEF6  86 94             	STX	Varnm2		; save 2nd character
CEF8  05 61             	ORA	Sufnxf		; or with subscript/FNX flag (or FN name)
CEFA  C9 28             	CMP	#'('			; compare with "("
CEFC  D0 03             	BNE	LAB_1D53		; branch if not "("

CEFE  4C C9CF           	JMP	LAB_1E17		; go find, or make, array

