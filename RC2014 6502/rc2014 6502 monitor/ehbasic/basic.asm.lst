                        ; set up function references

                        ; new for V2.0+ this replaces a lot of IF .. THEN .. ELSEIF .. THEN .. that was needed
                        ; to process function calls. now the function vector is computed and pushed on the stack
                        ; and the preprocess offset is read. if the preprocess offset is non zero then the vector
                        ; is calculated and the routine called, if not this routine just does RTS. whichever
                        ; happens the RTS at the end of this routine, or the end of the preprocess routine, calls
                        ; the function code

                        ; this also removes some less than elegant code that was used to bypass type checking
                        ; for functions that returned strings

CD5B                    LAB_1C27
CD5B  0A                	ASL				; *2 (2 bytes per function address)
CD5C  A8                	TAY				; copy to index

CD5D  B9 A9E3           	LDA	LAB_FTBM,Y		; get function jump vector high byte
CD60  48                	PHA				; push functions jump vector high byte
CD61  B9 A8E3           	LDA	LAB_FTBL,Y		; get function jump vector low byte
CD64  48                	PHA				; push functions jump vector low byte

CD65  B9 63E3           	LDA	LAB_FTPM,Y		; get function pre process vector high byte
CD68  F0 05             	BEQ	LAB_1C56		; skip pre process if null vector

CD6A  48                	PHA				; push functions pre process vector high byte
CD6B  B9 62E3           	LDA	LAB_FTPL,Y		; get function pre process vector low byte
CD6E  48                	PHA				; push functions pre process vector low byte

CD6F                    LAB_1C56
CD6F  60                	RTS				; do function, or pre process, call

                        ; process string expression in parenthesis

CD70                    LAB_PPFS
CD70  20 FDCC           	JSR	LAB_1BF7		; process expression in parenthesis
CD73  4C E3CB           	JMP	LAB_CTST		; check if source is string then do function,
                        					; else do type mismatch

                        ; process numeric expression in parenthesis

CD76                    LAB_PPFN
CD76  20 FDCC           	JSR	LAB_1BF7		; process expression in parenthesis
CD79  4C E1CB           	JMP	LAB_CTNM		; check if source is numeric then do function,
                        					; else do type mismatch

                        ; set numeric data type and increment BASIC execute pointer

CD7C                    LAB_PPBI
CD7C  46 5F             	LSR	Dtypef		; clear data type flag, $FF=string, $00=numeric
CD7E  4C BC00           	JMP	LAB_IGBY		; increment and scan memory then do function

