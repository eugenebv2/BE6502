DF7F                    LAB_CHEX
DF7F  20 BC00           	JSR	LAB_IGBY		; increment and scan memory
DF82  90 0A             	BCC	LAB_ISHN		; branch if numeric character

DF84  09 20             	ORA	#$20			; case convert, allow "A" to "F" and "a" to "f"
DF86  E9 61             	SBC	#'a'			; subtract "a" (carry set here)
DF88  C9 06             	CMP	#$06			; compare normalised with $06 (max+1)
DF8A  B0 2A             	BCS	LAB_EXCH		; exit if >"f" or <"0"

DF8C  69 0A             	ADC	#$0A			; convert to nibble
DF8E                    LAB_ISHN
DF8E  29 0F             	AND	#$0F			; convert to binary
DF90  AA                	TAX				; save nibble
DF91  A5 AC             	LDA	FAC1_e		; get FAC1 exponent
DF93  F0 E4             	BEQ	LAB_MLTE		; skip multiply if zero

DF95  69 04             	ADC	#$04			; add four to exponent (*16 - carry clear here)
DF97  90 DC             	BCC	LAB_NLTO		; if no overflow do evaluate digit

DF99                    LAB_MLTO
DF99  4C D4D7           	JMP	LAB_2564		; do overflow error and warm start

DF9C                    LAB_NXCH
DF9C  AA                	TAX				; save bit
DF9D  A5 AC             	LDA	FAC1_e		; get FAC1 exponent
DF9F  F0 06             	BEQ	LAB_MLBT		; skip multiply if zero

DFA1  E6 AC             	INC	FAC1_e		; increment FAC1 exponent (*2)
DFA3  F0 F4             	BEQ	LAB_MLTO		; do overflow error if = $00

DFA5  A9 00             	LDA	#$00			; clear sign compare
DFA7                    LAB_MLBT
DFA7  85 B8             	STA	FAC_sc		; save sign compare (FAC1 EOR FAC2)
DFA9  8A                	TXA				; restore bit
DFAA  20 56DB           	JSR	LAB_2912		; evaluate new ASCII digit

