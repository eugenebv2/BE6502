D0A1                    LAB_1EF3
D0A1  20 11C2           	JSR	LAB_121F		; check available memory, "Out of memory" error if no room
                        					; addr to check is in AY (low/high)
D0A4  85 7F             	STA	Earryl		; save array mem end low byte
D0A6  84 80             	STY	Earryh		; save array mem end high byte
D0A8  A9 00             	LDA	#$00			; clear byte for array clear
D0AA  E6 BB             	INC	Aspth			; increment array size high byte (now block count)
D0AC  A4 BA             	LDY	Asptl			; get array size low byte (now index to block)
D0AE  F0 05             	BEQ	LAB_1F07		; branch if low byte = $00

D0B0                    LAB_1F02
D0B0  88                	DEY				; decrement index (do 0 to n-1)
D0B1  91 A4             	STA	(Adatal),Y		; zero byte
D0B3  D0 FB             	BNE	LAB_1F02		; loop until this block done

D0B5                    LAB_1F07
D0B5  C6 A5             	DEC	Adatah		; decrement array pointer high byte
D0B7  C6 BB             	DEC	Aspth			; decrement block count high byte
D0B9  D0 F5             	BNE	LAB_1F02		; loop until all blocks done

D0BB  E6 A5             	INC	Adatah		; correct for last loop
D0BD  38                	SEC				; set carry for subtract
D0BE  A0 02             	LDY	#$02			; index to array size low byte
D0C0  A5 7F             	LDA	Earryl		; get array mem end low byte
D0C2  E5 AA             	SBC	Astrtl		; subtract array start low byte
D0C4  91 AA             	STA	(Astrtl),Y		; save array size low byte
D0C6  C8                	INY				; index to array size high byte
D0C7  A5 80             	LDA	Earryh		; get array mem end high byte
D0C9  E5 AB             	SBC	Astrth		; subtract array start high byte
D0CB  91 AA             	STA	(Astrtl),Y		; save array size high byte
D0CD  A5 5E             	LDA	Defdim		; get default DIM flag
D0CF  D0 53             	BNE	LAB_1F7B		; exit (RET) if this was a DIM command

                        					; else, find element
D0D1  C8                	INY				; index to # of dimensions

D0D2                    LAB_1F24
D0D2  B1 AA             	LDA	(Astrtl),Y		; get array's dimension count
D0D4  85 5D             	STA	Dimcnt		; save it

                        ; we have found, or built, the array. now we need to find the element

D0D6                    LAB_1F28
D0D6  A9 00             	LDA	#$00			; clear byte
D0D8  85 BA             	STA	Asptl			; clear array data pointer low byte
D0DA                    LAB_1F2C
D0DA  85 BB             	STA	Aspth			; save array data pointer high byte
D0DC  C8                	INY				; increment index (point to array bound high byte)
D0DD  68                	PLA				; pull array index low byte
D0DE  AA                	TAX				; copy to X
D0DF  85 AE             	STA	FAC1_2		; save index low byte to FAC1 mantissa2
D0E1  68                	PLA				; pull array index high byte
D0E2  85 AF             	STA	FAC1_3		; save index high byte to FAC1 mantissa3
D0E4  D1 AA             	CMP	(Astrtl),Y		; compare with array bound high byte
D0E6  90 0E             	BCC	LAB_1F48		; branch if within bounds

D0E8  D0 06             	BNE	LAB_1F42		; if outside bounds do array bounds error

                        					; else high byte was = so test low bytes
D0EA  C8                	INY				; index to array bound low byte
D0EB  8A                	TXA				; get array index low byte
D0EC  D1 AA             	CMP	(Astrtl),Y		; compare with array bound low byte
D0EE  90 07             	BCC	LAB_1F49		; branch if within bounds

D0F0                    LAB_1F42
D0F0  4C 37D0           	JMP	LAB_1E85		; else do array bounds error

D0F3                    LAB_1F45
D0F3  4C 40C2           	JMP	LAB_OMER		; do "Out of memory" error then warm start

D0F6                    LAB_1F48
D0F6  C8                	INY				; index to array bound low byte
D0F7                    LAB_1F49
D0F7  A5 BB             	LDA	Aspth			; get array data pointer high byte
D0F9  05 BA             	ORA	Asptl			; OR with array data pointer low byte
D0FB  F0 0A             	BEQ	LAB_1F5A		; branch if array data pointer = null (skip multiply)

D0FD  20 25D1           	JSR	LAB_1F7C		; does XY = (Astrtl),Y * (Asptl)
D100  8A                	TXA				; get result low byte
D101  65 AE             	ADC	FAC1_2		; add index low byte from FAC1 mantissa2
D103  AA                	TAX				; save result low byte
D104  98                	TYA				; get result high byte
D105  A4 71             	LDY	ut1_pl		; restore index
D107                    LAB_1F5A
D107  65 AF             	ADC	FAC1_3		; add index high byte from FAC1 mantissa3
D109  86 BA             	STX	Asptl			; save array data pointer low byte
D10B  C6 5D             	DEC	Dimcnt		; decrement dimensions count
D10D  D0 CB             	BNE	LAB_1F2C		; loop if dimensions still to do

D10F  06 BA             	ASL	Asptl			; array data pointer low byte * 2
D111  2A                	ROL				; array data pointer high byte * 2
D112  06 BA             	ASL	Asptl			; array data pointer low byte * 4
D114  2A                	ROL				; array data pointer high byte * 4
D115  A8                	TAY				; copy high byte
D116  A5 BA             	LDA	Asptl			; get low byte
D118  65 A4             	ADC	Adatal		; add array data start pointer low byte
D11A  85 95             	STA	Cvaral		; save as current var address low byte
D11C  98                	TYA				; get high byte back
D11D  65 A5             	ADC	Adatah		; add array data start pointer high byte
D11F  85 96             	STA	Cvarah		; save as current var address high byte
D121  A8                	TAY				; copy high byte to Y
D122  A5 95             	LDA	Cvaral		; get current var address low byte
D124                    LAB_1F7B
D124  60                	RTS

                        ; does XY = (Astrtl),Y * (Asptl)

D125                    LAB_1F7C
D125  84 71             	STY	ut1_pl		; save index
D127  B1 AA             	LDA	(Astrtl),Y		; get dimension size low byte
D129  85 76             	STA	dims_l		; save dimension size low byte
D12B  88                	DEY				; decrement index
D12C  B1 AA             	LDA	(Astrtl),Y		; get dimension size high byte
D12E  85 77             	STA	dims_h		; save dimension size high byte

D130  A9 10             	LDA	#$10			; count = $10 (16 bit multiply)
D132  85 A8             	STA	numbit		; save bit count
D134  A2 00             	LDX	#$00			; clear result low byte
D136  A0 00             	LDY	#$00			; clear result high byte
D138                    LAB_1F8F
D138  8A                	TXA				; get result low byte
D139  0A                	ASL				; *2
D13A  AA                	TAX				; save result low byte
D13B  98                	TYA				; get result high byte
D13C  2A                	ROL				; *2
D13D  A8                	TAY				; save result high byte
D13E  B0 B3             	BCS	LAB_1F45		; if overflow go do "Out of memory" error

D140  06 BA             	ASL	Asptl			; shift multiplier low byte
D142  26 BB             	ROL	Aspth			; shift multiplier high byte
D144  90 0B             	BCC	LAB_1FA8		; skip add if no carry

D146  18                	CLC				; else clear carry for add
D147  8A                	TXA				; get result low byte
D148  65 76             	ADC	dims_l		; add dimension size low byte
D14A  AA                	TAX				; save result low byte
D14B  98                	TYA				; get result high byte
D14C  65 77             	ADC	dims_h		; add dimension size high byte
D14E  A8                	TAY				; save result high byte
D14F  B0 A2             	BCS	LAB_1F45		; if overflow go do "Out of memory" error

D151                    LAB_1FA8
D151  C6 A8             	DEC	numbit		; decrement bit count
D153  D0 E3             	BNE	LAB_1F8F		; loop until all done

D155  60                	RTS

                        ; perform FRE()

D156                    LAB_FRE
D156  A5 5F             	LDA	Dtypef		; get data type flag, $FF=string, $00=numeric
D158  10 03             	BPL	LAB_1FB4		; branch if numeric

D15A  20 4FD4           	JSR	LAB_22B6		; pop string off descriptor stack, or from top of string
                        					; space returns with A = length, X=$71=pointer low byte,
                        					; Y=$72=pointer high byte

                        					; FRE(n) was numeric so do this
D15D                    LAB_1FB4
D15D  20 F0D2           	JSR	LAB_GARB		; go do garbage collection
D160  38                	SEC				; set carry for subtract
D161  A5 81             	LDA	Sstorl		; get bottom of string space low byte
D163  E5 7F             	SBC	Earryl		; subtract array mem end low byte
D165  A8                	TAY				; copy result to Y
D166  A5 82             	LDA	Sstorh		; get bottom of string space high byte
