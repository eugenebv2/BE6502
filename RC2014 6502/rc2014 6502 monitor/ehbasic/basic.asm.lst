DE8E  10 16             	BPL	LAB_2D04		; exit if was +ve

DE90  4C 05DD           	JMP	LAB_GTHAN		; else do - FAC1 and return

                        ; perform BITSET

DE93                    LAB_BITSET
DE93  20 E9D5           	JSR	LAB_GADB		; get two parameters for POKE or WAIT
DE96  E0 08             	CPX	#$08			; only 0 to 7 are allowed
DE98  B0 20             	BCS	FCError		; branch if > 7

DE9A  A9 00             	LDA	#$00			; clear A
DE9C  38                	SEC				; set the carry
DE9D                    S_Bits
DE9D  2A                	ROL				; shift bit
DE9E  CA                	DEX				; decrement bit number
DE9F  10 FC             	BPL	S_Bits		; loop if still +ve

DEA1  E8                	INX				; make X = $00
DEA2  01 11             	ORA	(Itempl,X)		; or with byte via temporary integer (addr)
DEA4  81 11             	STA	(Itempl,X)		; save byte via temporary integer (addr)
DEA6                    LAB_2D04
DEA6  60                	RTS

                        ; perform BITCLR

DEA7                    LAB_BITCLR
DEA7  20 E9D5           	JSR	LAB_GADB		; get two parameters for POKE or WAIT
DEAA  E0 08             	CPX	#$08			; only 0 to 7 are allowed
DEAC  B0 0C             	BCS	FCError		; branch if > 7

DEAE  A9 FF             	LDA	#$FF			; set A
DEB0                    S_Bitc
DEB0  2A                	ROL				; shift bit
DEB1  CA                	DEX				; decrement bit number
DEB2  10 FC             	BPL	S_Bitc		; loop if still +ve

DEB4  E8                	INX				; make X = $00
DEB5  21 11             	AND	(Itempl,X)		; and with byte via temporary integer (addr)
DEB7  81 11             	STA	(Itempl,X)		; save byte via temporary integer (addr)
DEB9  60                	RTS

DEBA                    FCError
DEBA  4C 3AD0           	JMP	LAB_FCER		; do function call error then warm start

                        ; perform BITTST()

DEBD                    LAB_BTST
DEBD  20 BC00           	JSR	LAB_IGBY		; increment BASIC pointer
DEC0  20 E9D5           	JSR	LAB_GADB		; get two parameters for POKE or WAIT
DEC3  E0 08             	CPX	#$08			; only 0 to 7 are allowed
DEC5  B0 F3             	BCS	FCError		; branch if > 7

DEC7  20 C200           	JSR	LAB_GBYT		; get next BASIC byte
DECA  C9 29             	CMP	#')'			; is next character ")"
DECC  F0 03             	BEQ	TST_OK		; if ")" go do rest of function

DECE  4C 13CD           	JMP	LAB_SNER		; do syntax error then warm start

DED1                    TST_OK
DED1  20 BC00           	JSR	LAB_IGBY		; update BASIC execute pointer (to character past ")")
DED4  A9 00             	LDA	#$00			; clear A
DED6  38                	SEC				; set the carry
DED7                    T_Bits
DED7  2A                	ROL				; shift bit
DED8  CA                	DEX				; decrement bit number
DED9  10 FC             	BPL	T_Bits		; loop if still +ve

DEDB  E8                	INX				; make X = $00
DEDC  21 11             	AND	(Itempl,X)		; AND with byte via temporary integer (addr)
DEDE  F0 02             	BEQ	LAB_NOTT		; branch if zero (already correct)

DEE0  A9 FF             	LDA	#$FF			; set for -1 result
DEE2                    LAB_NOTT
DEE2  4C 0BDA           	JMP	LAB_27DB		; go do SGN tail

                        ; perform BIN$()

DEE5                    LAB_BINS
DEE5  E0 19             	CPX	#$19			; max + 1
DEE7  B0 48             	BCS	BinFErr		; exit if too big ( > or = )

DEE9  86 78             	STX	TempB			; save # of characters ($00 = leading zero remove)
DEEB  A9 18             	LDA	#$18			; need A byte long space
DEED  20 4BD2           	JSR	LAB_MSSP		; make string space A bytes long
DEF0  A0 17             	LDY	#$17			; set index
DEF2  A2 18             	LDX	#$18			; character count
DEF4                    NextB1
DEF4  46 11             	LSR	nums_1		; shift highest byte
DEF6  66 12             	ROR	nums_2		; shift middle byte
DEF8  66 13             	ROR	nums_3		; shift lowest byte bit 0 to carry
DEFA  8A                	TXA				; load with "0"/2
DEFB  2A                	ROL				; shift in carry
DEFC  91 AD             	STA	(str_pl),Y		; save to temp string + index
DEFE  88                	DEY				; decrement index
DEFF  10 F3             	BPL	NextB1		; loop if not done

DF01  A5 78             	LDA	TempB			; get # of characters
DF03  F0 0A             	BEQ	EndBHS		; branch if truncate

DF05  AA                	TAX				; copy length to X
DF06  38                	SEC				; set carry for add !
DF07  49 FF             	EOR	#$FF			; 1's complement
DF09  69 18             	ADC	#$18			; add 24d
DF0B  F0 1C             	BEQ	GoPr2			; if zero print whole string

DF0D  D0 0F             	BNE	GoPr1			; else go make output string
                        	
                        ; this is the exit code and is also used by HEX$()
                        ; truncate string to remove leading "0"s

DF0F                    EndBHS
DF0F  A8                	TAY				; clear index (A=0, X=length here)
DF10                    NextB2
DF10  B1 AD             	LDA	(str_pl),Y		; get character from string
DF12  C9 30             	CMP	#'0'			; compare with "0"
DF14  D0 07             	BNE	GoPr			; if not "0" then go print string from here

DF16  CA                	DEX				; decrement character count
DF17  F0 03             	BEQ	GoPr3			; if zero then end of string so go print it

DF19  C8                	INY				; else increment index
DF1A  10 F4             	BPL	NextB2		; loop always

                        ; make fixed length output string - ignore overflows!

DF1C                    GoPr3
DF1C  E8                	INX				; need at least 1 character
DF1D                    GoPr
DF1D  98                	TYA				; copy result
DF1E                    GoPr1
DF1E  18                	CLC				; clear carry for add
DF1F  65 AD             	ADC	str_pl		; add low address
DF21  85 AD             	STA	str_pl		; save low address
DF23  A9 00             	LDA	#$00			; do high byte
DF25  65 AE             	ADC	str_ph		; add high address
DF27  85 AE             	STA	str_ph		; save high address
DF29                    GoPr2
DF29  86 AC             	STX	str_ln		; X holds string length
DF2B  20 BC00           	JSR	LAB_IGBY		; update BASIC execute pointer (to character past ")")
DF2E  4C 96D2           	JMP	LAB_RTST		; check for space on descriptor stack then put address
                        					; and length on descriptor stack and update stack pointers

DF31                    BinFErr
DF31  4C 3AD0           	JMP	LAB_FCER		; do function call error then warm start

                        ; perform HEX$()

DF34                    LAB_HEXS
DF34  E0 07             	CPX	#$07			; max + 1
DF36  B0 F9             	BCS	BinFErr		; exit if too big ( > or = )

DF38  86 78             	STX	TempB			; save # of characters

DF3A  A9 06             	LDA	#$06			; need 6 bytes for string
DF3C  20 4BD2           	JSR	LAB_MSSP		; make string space A bytes long
DF3F  A0 05             	LDY	#$05			; set string index

DF41  F8                	SED				; need decimal mode for nibble convert
DF42  A5 13             	LDA	nums_3		; get lowest byte
DF44  20 62DF           	JSR	LAB_A2HX		; convert A to ASCII hex byte and output
DF47  A5 12             	LDA	nums_2		; get middle byte
DF49  20 62DF           	JSR	LAB_A2HX		; convert A to ASCII hex byte and output
DF4C  A5 11             	LDA	nums_1		; get highest byte
DF4E  20 62DF           	JSR	LAB_A2HX		; convert A to ASCII hex byte and output
DF51  D8                	CLD				; back to binary

DF52  A2 06             	LDX	#$06			; character count
DF54  A5 78             	LDA	TempB			; get # of characters
DF56  F0 B7             	BEQ	EndBHS		; branch if truncate

DF58  AA                	TAX				; copy length to X
DF59  38                	SEC				; set carry for add !
DF5A  49 FF             	EOR	#$FF			; 1's complement
DF5C  69 06             	ADC	#$06			; add 6d
DF5E  F0 C9             	BEQ	GoPr2			; if zero print whole string

DF60  D0 BC             	BNE	GoPr1			; else go make output string (branch always)

