                        ;
                        ; Original version:
                        ;       Enhanced BASIC to assemble under 6502 simulator, $ver 2.22
                        ; Original copyright:
                        ;       Lee Davison, RIP
                        ;
                        ; This version was pulled from the github repository of klaus2m5
                        ;
                        ; $E7E1 $E7CF $E7C6 $E7D3 $E7D1 $E7D5 $E7CF $E81E $E825
                        ;
                        ; 2.00	new revision numbers start here
                        ; 2.01	fixed LCASE$() and UCASE$()
                        ; 2.02	new get value routine done
                        ; 2.03	changed RND() to galoise method
                        ; 2.04	fixed SPC()
                        ; 2.05	new get value routine fixed
                        ; 2.06	changed USR() code
                        ; 2.07	fixed STR$()
                        ; 2.08	changed INPUT and READ to remove need for $00 start to input buffer
                        ; 2.09	fixed RND()
                        ; 2.10	integrated missed changes from an earlier version
                        ; 2.20	added ELSE to IF .. THEN and fixed IF .. GOTO <statement> to cause error
                        ; 2.21	fixed IF .. THEN RETURN to not cause error
                        ; 2.22	fixed RND() breaking the get byte routine
                        ;
                        ; -----------------------------------------------
                        ; RAM usage
                        ; 0000 - 00FF    = zero page
                        ; 0100 - 01FF   = stack
                        ; 0200 - 02FF   = misc flags & vectors & buffers
                        ; 0300 - 03FF   = misc Monitor stuff
                        ; 0500 -        = main memory

      = FF03            input_char      = $ff03
      = FF06            check_input     = $ff06
      = FF09            output_char     = $ff09

                        ; zero page use ..

      = 0000            LAB_WARM 		= $00		; BASIC warm start entry point
      = 0001            Wrmjpl 		= LAB_WARM+1; BASIC warm start vector jump low byte
      = 0002            Wrmjph 		= LAB_WARM+2; BASIC warm start vector jump high byte

      = 000A            Usrjmp		= $0A		; USR function JMP address
      = 000B            Usrjpl		= Usrjmp+1	; USR function JMP vector low byte
      = 000C            Usrjph		= Usrjmp+2	; USR function JMP vector high byte
      = 000D            Nullct		= $0D		; nulls output after each line
      = 000E            TPos			= $0E		; BASIC terminal position byte
      = 000F            TWidth		= $0F		; BASIC terminal width byte
      = 0010            Iclim			= $10		; input column limit
      = 0011            Itempl		= $11		; temporary integer low byte
      = 0012            Itemph		= Itempl+1	; temporary integer high byte

      = 0011            nums_1		= Itempl	; number to bin/hex string convert MSB
      = 0012            nums_2		= nums_1+1	; number to bin/hex string convert
      = 0013            nums_3		= nums_1+2	; number to bin/hex string convert LSB

      = 005B            Srchc			= $5B		; search character
      = 005B            Temp3			= Srchc	; temp byte used in number routines
      = 005C            Scnquo		= $5C		; scan-between-quotes flag
      = 005C            Asrch			= Scnquo	; alt search character

      = 005B            XOAw_l		= Srchc	; eXclusive OR, OR and AND word low byte
      = 005C            XOAw_h		= Scnquo	; eXclusive OR, OR and AND word high byte

      = 005D            Ibptr			= $5D		; input buffer pointer
      = 005D            Dimcnt		= Ibptr	; # of dimensions
      = 005D            Tindx			= Ibptr	; token index

      = 005E            Defdim		= $5E		; default DIM flag
      = 005F            Dtypef		= $5F		; data type flag, $FF=string, $00=numeric
      = 0060            Oquote		= $60		; open quote flag (b7) (Flag: DATA scan; LIST quote; memory)
      = 0060            Gclctd		= $60		; garbage collected flag
      = 0061            Sufnxf		= $61		; subscript/FNX flag, 1xxx xxx = FN(0xxx xxx)
      = 0062            Imode			= $62		; input mode flag, $00=INPUT, $80=READ

      = 0063            Cflag			= $63		; comparison evaluation flag

      = 0064            TabSiz		= $64		; TAB step size (was input flag)

      = 0065            next_s		= $65		; next descriptor stack address

                        					; these two bytes form a word pointer to the item
                        					; currently on top of the descriptor stack
      = 0066            last_sl		= $66		; last descriptor stack address low byte
      = 0067            last_sh		= $67		; last descriptor stack address high byte (always $00)

      = 0068            des_sk		= $68		; descriptor stack start address (temp strings)

                        ;			= $70		; End of descriptor stack

      = 0071            ut1_pl		= $71		; utility pointer 1 low byte
      = 0072            ut1_ph		= ut1_pl+1	; utility pointer 1 high byte
      = 0073            ut2_pl		= $73		; utility pointer 2 low byte
      = 0074            ut2_ph		= ut2_pl+1	; utility pointer 2 high byte

      = 0071            Temp_2		= ut1_pl	; temp byte for block move	

      = 0075            FACt_1		= $75		; FAC temp mantissa1
      = 0076            FACt_2		= FACt_1+1	; FAC temp mantissa2
      = 0077            FACt_3		= FACt_2+1	; FAC temp mantissa3

      = 0076            dims_l		= FACt_2	; array dimension size low byte
      = 0077            dims_h		= FACt_3	; array dimension size high byte

      = 0078            TempB			= $78		; temp page 0 byte

      = 0079            Smeml			= $79		; start of mem low byte		(Start-of-Basic)
      = 007A            Smemh			= Smeml+1	; start of mem high byte	(Start-of-Basic)
      = 007B            Svarl			= $7B		; start of vars low byte	(Start-of-Variables)
      = 007C            Svarh			= Svarl+1	; start of vars high byte	(Start-of-Variables)
      = 007D            Sarryl		= $7D		; var mem end low byte		(Start-of-Arrays)
      = 007E            Sarryh		= Sarryl+1	; var mem end high byte		(Start-of-Arrays)
      = 007F            Earryl		= $7F		; array mem end low byte	(End-of-Arrays)
      = 0080            Earryh		= Earryl+1	; array mem end high byte	(End-of-Arrays)
      = 0081            Sstorl		= $81		; string storage low byte	(String storage (moving down))
      = 0082            Sstorh		= Sstorl+1	; string storage high byte	(String storage (moving down))
      = 0083            Sutill		= $83		; string utility ptr low byte
      = 0084            Sutilh		= Sutill+1	; string utility ptr high byte
      = 0085            Ememl			= $85		; end of mem low byte		(Limit-of-memory)
      = 0086            Ememh			= Ememl+1	; end of mem high byte		(Limit-of-memory)
      = 0087            Clinel		= $87		; current line low byte		(Basic line number)
      = 0088            Clineh		= Clinel+1	; current line high byte	(Basic line number)
      = 0089            Blinel		= $89		; break line low byte		(Previous Basic line number)
      = 008A            Blineh		= Blinel+1	; break line high byte		(Previous Basic line number)

      = 008B            Cpntrl		= $8B		; continue pointer low byte
      = 008C            Cpntrh		= Cpntrl+1	; continue pointer high byte

      = 008D            Dlinel		= $8D		; current DATA line low byte
      = 008E            Dlineh		= Dlinel+1	; current DATA line high byte

      = 008F            Dptrl			= $8F		; DATA pointer low byte
      = 0090            Dptrh			= Dptrl+1	; DATA pointer high byte

      = 0091            Rdptrl		= $91		; read pointer low byte
      = 0092            Rdptrh		= Rdptrl+1	; read pointer high byte

      = 0093            Varnm1		= $93		; current var name 1st byte
      = 0094            Varnm2		= Varnm1+1	; current var name 2nd byte

      = 0095            Cvaral		= $95		; current var address low byte
      = 0096            Cvarah		= Cvaral+1	; current var address high byte

      = 0097            Frnxtl		= $97		; var pointer for FOR/NEXT low byte
      = 0098            Frnxth		= Frnxtl+1	; var pointer for FOR/NEXT high byte

      = 0097            Tidx1			= Frnxtl	; temp line index

      = 0097            Lvarpl		= Frnxtl	; let var pointer low byte
      = 0098            Lvarph		= Frnxth	; let var pointer high byte

      = 0099            prstk			= $99		; precedence stacked flag

      = 009B            comp_f		= $9B		; compare function flag, bits 0,1 and 2 used
                        					; bit 2 set if >
                        					; bit 1 set if =
                        					; bit 0 set if <

      = 009C            func_l		= $9C		; function pointer low byte
      = 009D            func_h		= func_l+1	; function pointer high byte

      = 009C            garb_l		= func_l	; garbage collection working pointer low byte
      = 009D            garb_h		= func_h	; garbage collection working pointer high byte

      = 009E            des_2l		= $9E		; string descriptor_2 pointer low byte
      = 009F            des_2h		= des_2l+1	; string descriptor_2 pointer high byte

      = 00A0            g_step		= $A0		; garbage collect step size

      = 00A1            Fnxjmp		= $A1		; jump vector for functions
      = 00A2            Fnxjpl		= Fnxjmp+1	; functions jump vector low byte
      = 00A3            Fnxjph		= Fnxjmp+2	; functions jump vector high byte

      = 00A2            g_indx		= Fnxjpl	; garbage collect temp index

      = 00A3            FAC2_r		= $A3		; FAC2 rounding byte

      = 00A4            Adatal		= $A4		; array data pointer low byte
      = 00A5            Adatah		= Adatal+1	; array data pointer high  byte

      = 00A4            Nbendl		= Adatal	; new block end pointer low byte
      = 00A5            Nbendh		= Adatah	; new block end pointer high  byte

      = 00A6            Obendl		= $A6		; old block end pointer low byte
      = 00A7            Obendh		= Obendl+1	; old block end pointer high  byte

      = 00A8            numexp		= $A8		; string to float number exponent count
      = 00A9            expcnt		= $A9		; string to float exponent count

      = 00A8            numbit		= numexp	; bit count for array element calculations

      = 00AA            numdpf		= $AA		; string to float decimal point flag
      = 00AB            expneg		= $AB		; string to float eval exponent -ve flag

      = 00AA            Astrtl		= numdpf	; array start pointer low byte
      = 00AB            Astrth		= expneg	; array start pointer high  byte

      = 00AA            Histrl		= numdpf	; highest string low byte
      = 00AB            Histrh		= expneg	; highest string high  byte

      = 00AA            Baslnl		= numdpf	; BASIC search line pointer low byte
      = 00AB            Baslnh		= expneg	; BASIC search line pointer high  byte

      = 00AA            Fvar_l		= numdpf	; find/found variable pointer low byte
      = 00AB            Fvar_h		= expneg	; find/found variable pointer high  byte

      = 00AA            Ostrtl		= numdpf	; old block start pointer low byte
      = 00AB            Ostrth		= expneg	; old block start pointer high  byte

      = 00AA            Vrschl		= numdpf	; variable search pointer low byte
      = 00AB            Vrschh		= expneg	; variable search pointer high  byte

      = 00AC            FAC1_e		= $AC		; FAC1 exponent
      = 00AD            FAC1_1		= FAC1_e+1	; FAC1 mantissa1
      = 00AE            FAC1_2		= FAC1_e+2	; FAC1 mantissa2
      = 00AF            FAC1_3		= FAC1_e+3	; FAC1 mantissa3
      = 00B0            FAC1_s		= FAC1_e+4	; FAC1 sign (b7)

      = 00AC            str_ln		= FAC1_e	; string length
      = 00AD            str_pl		= FAC1_1	; string pointer low byte
      = 00AE            str_ph		= FAC1_2	; string pointer high byte

      = 00AE            des_pl		= FAC1_2	; string descriptor pointer low byte
      = 00AF            des_ph		= FAC1_3	; string descriptor pointer high byte

      = 00AF            mids_l		= FAC1_3	; MID$ string temp length byte

      = 00B1            negnum		= $B1		; string to float eval -ve flag
      = 00B1            numcon		= $B1		; series evaluation constant count

      = 00B2            FAC1_o		= $B2		; FAC1 overflow byte

      = 00B3            FAC2_e		= $B3		; FAC2 exponent
      = 00B4            FAC2_1		= FAC2_e+1	; FAC2 mantissa1
      = 00B5            FAC2_2		= FAC2_e+2	; FAC2 mantissa2
      = 00B6            FAC2_3		= FAC2_e+3	; FAC2 mantissa3
      = 00B7            FAC2_s		= FAC2_e+4	; FAC2 sign (b7)

      = 00B8            FAC_sc		= $B8		; FAC sign comparison, Acc#1 vs #2
      = 00B9            FAC1_r		= $B9		; FAC1 rounding byte

      = 00B8            ssptr_l		= FAC_sc	; string start pointer low byte
      = 00B9            ssptr_h		= FAC1_r	; string start pointer high byte

      = 00B8            sdescr		= FAC_sc	; string descriptor pointer

      = 00BA            csidx			= $BA		; line crunch save index
      = 00BA            Asptl			= csidx	; array size/pointer low byte
      = 00BB            Aspth			= $BB		; array size/pointer high byte

      = 00BA            Btmpl			= Asptl	; BASIC pointer temp low byte
      = 00BB            Btmph			= Aspth	; BASIC pointer temp low byte

      = 00BA            Cptrl			= Asptl	; BASIC pointer temp low byte
      = 00BB            Cptrh			= Aspth	; BASIC pointer temp low byte

      = 00BA            Sendl			= Asptl	; BASIC pointer temp low byte
      = 00BB            Sendh			= Aspth	; BASIC pointer temp low byte

      = 00BC            LAB_IGBY		= $BC		; get next BASIC byte subroutine

      = 00C2            LAB_GBYT		= $C2		; get current BASIC byte subroutine
      = 00C3            Bpntrl		= $C3		; BASIC execute (get byte) pointer low byte
      = 00C4            Bpntrh		= Bpntrl+1	; BASIC execute (get byte) pointer high byte

                        ;			= $D7		; end of get BASIC char subroutine

      = 00D8            Rbyte4		= $D8		; extra PRNG byte
      = 00D9            Rbyte1		= Rbyte4+1	; most significant PRNG byte
      = 00DA            Rbyte2		= Rbyte4+2	; middle PRNG byte
      = 00DB            Rbyte3		= Rbyte4+3	; least significant PRNG byte

      = 00DC            NmiBase		= $DC		; NMI handler enabled/setup/triggered flags
                        					; bit	function
                        					; ===	========
                        					; 7	interrupt enabled
                        					; 6	interrupt setup
                        					; 5	interrupt happened
                        ;			= $DD		; NMI handler addr low byte
                        ;			= $DE		; NMI handler addr high byte
      = 00DF            IrqBase		= $DF		; IRQ handler enabled/setup/triggered flags
                        ;			= $E0		; IRQ handler addr low byte
                        ;			= $E1		; IRQ handler addr high byte

                        ;			= $DE		; unused
                        ;			= $DF		; unused
                        ;			= $E0		; unused
                        ;			= $E1		; unused
                        ;			= $E2		; unused
                        ;			= $E3		; unused
                        ;			= $E4		; unused
                        ;			= $E5		; unused
                        ;			= $E6		; unused
                        ;			= $E7		; unused
                        ;			= $E8		; unused
                        ;			= $E9		; unused
                        ;			= $EA		; unused
                        ;			= $EB		; unused
                        ;			= $EC		; unused
                        ;			= $ED		; unused
                        ;			= $EE		; unused

      = 00EF            Decss			= $EF		; number to decimal string start
      = 00F0            Decssp1		= Decss+1	; number to decimal string start

                        ;			= $FF		; decimal string end

                        ; token values needed for BASIC

                        ; primary command tokens (can start a statement)

      = 0080            TK_END		= $80			; END token
      = 0081            TK_FOR		= TK_END+1		; FOR token
      = 0082            TK_NEXT		= TK_FOR+1		; NEXT token
      = 0083            TK_DATA		= TK_NEXT+1		; DATA token
      = 0084            TK_INPUT		= TK_DATA+1		; INPUT token
      = 0085            TK_DIM		= TK_INPUT+1	; DIM token
      = 0086            TK_READ		= TK_DIM+1		; READ token
      = 0087            TK_LET		= TK_READ+1		; LET token
      = 0088            TK_DEC		= TK_LET+1		; DEC token
      = 0089            TK_GOTO		= TK_DEC+1		; GOTO token
      = 008A            TK_RUN		= TK_GOTO+1		; RUN token
      = 008B            TK_IF			= TK_RUN+1		; IF token
      = 008C            TK_RESTORE		= TK_IF+1		; RESTORE token
      = 008D            TK_GOSUB		= TK_RESTORE+1	; GOSUB token
      = 008E            TK_RETIRQ		= TK_GOSUB+1	; RETIRQ token
      = 008F            TK_RETNMI		= TK_RETIRQ+1	; RETNMI token
      = 0090            TK_RETURN		= TK_RETNMI+1	; RETURN token
      = 0091            TK_REM		= TK_RETURN+1	; REM token
      = 0092            TK_STOP		= TK_REM+1		; STOP token
      = 0093            TK_ON			= TK_STOP+1		; ON token
      = 0094            TK_NULL		= TK_ON+1		; NULL token
      = 0095            TK_INC		= TK_NULL+1		; INC token
      = 0096            TK_WAIT		= TK_INC+1		; WAIT token
      = 0097            TK_LOAD		= TK_WAIT+1		; LOAD token
      = 0098            TK_SAVE		= TK_LOAD+1		; SAVE token
      = 0099            TK_DEF		= TK_SAVE+1		; DEF token
      = 009A            TK_POKE		= TK_DEF+1		; POKE token
      = 009B            TK_DOKE		= TK_POKE+1		; DOKE token
      = 009C            TK_CALL		= TK_DOKE+1		; CALL token
      = 009D            TK_DO			= TK_CALL+1		; DO token
      = 009E            TK_LOOP		= TK_DO+1		; LOOP token
      = 009F            TK_PRINT		= TK_LOOP+1		; PRINT token
      = 00A0            TK_CONT		= TK_PRINT+1	; CONT token
      = 00A1            TK_LIST		= TK_CONT+1		; LIST token
      = 00A2            TK_CLEAR		= TK_LIST+1		; CLEAR token
      = 00A3            TK_NEW		= TK_CLEAR+1	; NEW token
      = 00A4            TK_WIDTH		= TK_NEW+1		; WIDTH token
      = 00A5            TK_GET		= TK_WIDTH+1	; GET token
      = 00A6            TK_SWAP		= TK_GET+1		; SWAP token
      = 00A7            TK_BITSET		= TK_SWAP+1		; BITSET token
      = 00A8            TK_BITCLR		= TK_BITSET+1	; BITCLR token
      = 00A9            TK_IRQ		= TK_BITCLR+1	; IRQ token
      = 00AA            TK_NMI		= TK_IRQ+1		; NMI token
      = 00AB            TK_SYS          = TK_NMI+1

                        ; secondary command tokens, can't start a statement

                        ;;TK_TAB		= TK_NMI+1		; TAB token
      = 00AC            TK_TAB		= TK_SYS+1		; TAB token
      = 00AD            TK_ELSE		= TK_TAB+1		; ELSE token
      = 00AE            TK_TO			= TK_ELSE+1		; TO token
      = 00AF            TK_FN			= TK_TO+1		; FN token
      = 00B0            TK_SPC		= TK_FN+1		; SPC token
      = 00B1            TK_THEN		= TK_SPC+1		; THEN token
      = 00B2            TK_NOT		= TK_THEN+1		; NOT token
      = 00B3            TK_STEP		= TK_NOT+1		; STEP token
      = 00B4            TK_UNTIL		= TK_STEP+1		; UNTIL token
      = 00B5            TK_WHILE		= TK_UNTIL+1	; WHILE token
      = 00B6            TK_OFF		= TK_WHILE+1	; OFF token

                        ; opperator tokens

      = 00B7            TK_PLUS		= TK_OFF+1		; + token
      = 00B8            TK_MINUS		= TK_PLUS+1		; - token
      = 00B9            TK_MUL		= TK_MINUS+1	; * token
      = 00BA            TK_DIV		= TK_MUL+1		; / token
      = 00BB            TK_POWER		= TK_DIV+1		; ^ token
      = 00BC            TK_AND		= TK_POWER+1	; AND token
      = 00BD            TK_EOR		= TK_AND+1		; EOR token
      = 00BE            TK_OR			= TK_EOR+1		; OR token
      = 00BF            TK_RSHIFT		= TK_OR+1		; RSHIFT token
      = 00C0            TK_LSHIFT		= TK_RSHIFT+1	; LSHIFT token
      = 00C1            TK_GT			= TK_LSHIFT+1	; > token
      = 00C2            TK_EQUAL		= TK_GT+1		; = token
      = 00C3            TK_LT			= TK_EQUAL+1	; < token

                        ; functions tokens

      = 00C4            TK_SGN		= TK_LT+1		; SGN token
      = 00C5            TK_INT		= TK_SGN+1		; INT token
      = 00C6            TK_ABS		= TK_INT+1		; ABS token
      = 00C7            TK_USR		= TK_ABS+1		; USR token
      = 00C8            TK_FRE		= TK_USR+1		; FRE token
      = 00C9            TK_POS		= TK_FRE+1		; POS token
      = 00CA            TK_SQR		= TK_POS+1		; SQR token
      = 00CB            TK_RND		= TK_SQR+1		; RND token
      = 00CC            TK_LOG		= TK_RND+1		; LOG token
      = 00CD            TK_EXP		= TK_LOG+1		; EXP token
      = 00CE            TK_COS		= TK_EXP+1		; COS token
      = 00CF            TK_SIN		= TK_COS+1		; SIN token
      = 00D0            TK_TAN		= TK_SIN+1		; TAN token
      = 00D1            TK_ATN		= TK_TAN+1		; ATN token
      = 00D2            TK_PEEK		= TK_ATN+1		; PEEK token
      = 00D3            TK_DEEK		= TK_PEEK+1		; DEEK token
      = 00D4            TK_SADD		= TK_DEEK+1		; SADD token
      = 00D5            TK_LEN		= TK_SADD+1		; LEN token
      = 00D6            TK_STRS		= TK_LEN+1		; STR$ token
      = 00D7            TK_VAL		= TK_STRS+1		; VAL token
      = 00D8            TK_ASC		= TK_VAL+1		; ASC token
      = 00D9            TK_UCASES		= TK_ASC+1		; UCASE$ token
      = 00DA            TK_LCASES		= TK_UCASES+1	; LCASE$ token
      = 00DB            TK_CHRS		= TK_LCASES+1	; CHR$ token
      = 00DC            TK_HEXS		= TK_CHRS+1		; HEX$ token
      = 00DD            TK_BINS		= TK_HEXS+1		; BIN$ token
      = 00DE            TK_BITTST		= TK_BINS+1		; BITTST token
      = 00DF            TK_MAX		= TK_BITTST+1	; MAX token
      = 00E0            TK_MIN		= TK_MAX+1		; MIN token
      = 00E1            TK_PI			= TK_MIN+1		; PI token
      = 00E2            TK_TWOPI		= TK_PI+1		; TWOPI token
      = 00E3            TK_VPTR		= TK_TWOPI+1	; VARPTR token
      = 00E4            TK_LEFTS		= TK_VPTR+1		; LEFT$ token
      = 00E5            TK_RIGHTS		= TK_LEFTS+1	; RIGHT$ token
      = 00E6            TK_MIDS		= TK_RIGHTS+1	; MID$ token

                        ; offsets from a base of X or Y

      = 0000            PLUS_0		= $00		; X or Y plus 0
      = 0001            PLUS_1		= $01		; X or Y plus 1
      = 0002            PLUS_2		= $02		; X or Y plus 2
      = 0003            PLUS_3		= $03		; X or Y plus 3

                        ; -----------------------------------------------
                        ; Stack page, Page 1
                        ; -----------------------------------------------

      = 0100            LAB_STAK		= $0100	; stack bottom, no offset

      = 01FE            LAB_SKFE		= LAB_STAK+$FE
                        					; flushed stack address
      = 01FF            LAB_SKFF		= LAB_STAK+$FF
                        					; flushed stack address
                        ; -----------------------------------------------
                        ; Page 2
                        ; -----------------------------------------------

      = 0200            ccflag		= $0200	; BASIC CTRL-C flag, 00 = enabled, 01 = dis
      = 0201            ccbyte		= ccflag+1	; BASIC CTRL-C byte
      = 0202            ccnull		= ccbyte+1	; BASIC CTRL-C byte timeout

      = 0203            VEC_CC		= ccnull+1	; ctrl c check vector

      = 0205            VEC_IN		= VEC_CC+2	; input vector
      = 0207            VEC_OUT		= VEC_IN+2	; output vector
      = 0209            VEC_LD		= VEC_OUT+2	; load vector
      = 020B            VEC_SV		= VEC_LD+2	; save vector

                        ; Ibuffs cannot be anywhere in RAM
                        ; It has to be in the same Page as ccflag
                        ; ensure that the max length is < $80
      = 020D            IRQ_vec	= VEC_SV+2		; IRQ code vector
      = 0221            Ibuffs		= IRQ_vec+$14
                        					; start of input buffer after IRQ/NMI code
      = 0268            Ibuffe		= Ibuffs+$47; end of input buffer

                        ; -----------------------------------------------
                        ; Main RAM
                        ; -----------------------------------------------
                        ; Set hardware configuration here
      = 0400            Ram_base	= $0400	; start of user RAM (set as needed, should be page aligned)

                        ; $8000 = 32KB of RAM in system
                        ; $c000 = if you have 48KB of RAM
                        ;Ram_top		= $5000	; end of user RAM+1 (set as needed, should be page aligned)
      = 8000            Ram_top		= $8000	; end of user RAM+1 (set as needed, should be page aligned)

                        ; -----------------------------------------------
                        ; Program space
                        ; -----------------------------------------------
                        ; Note that Program space has to be in higher memory than RAM
                        ; This is for execution in ROM
C100                            .org    $c100   ; Start after RC2014 IO space
                        ; This is for execution in RAM
                        ;        .org    $5000   ;

C100                    basic_start_address

                        ; BASIC cold start entry point
C100  4C 06C1                   jmp     LAB_COLD
C103  4C 60C2                   jmp     LAB_1274                ; Warm start
                        ; new page 2 initialisation, copy block to ccflag on

C106                    LAB_COLD
C106  A0 04             	LDY	#PG2_TABE-PG2_TABS-1
                        					; byte count-1
C108                    LAB_2D13
C108  B9 F9E1           	LDA	PG2_TABS,Y		; get byte
C10B  99 0002           	STA	ccflag,Y		; store in page 2
C10E  88                	DEY				; decrement count
C10F  10 F7             	BPL	LAB_2D13		; loop if not done

C111  A2 FF             	LDX	#$FF			; set byte
C113  86 88             	STX	Clineh		; set current line high byte (set immediate mode)
C115  9A                	TXS				; reset stack pointer

C116  A9 4C             	LDA	#$4C			; code for JMP
C118  85 A1             	STA	Fnxjmp		; save for jump vector for functions

                        ; copy block from LAB_2CEE to $00BC - $00D3

C11A  A2 1C             	LDX	#StrTab-LAB_2CEE	; set byte count
C11C                    LAB_2D4E
C11C  BD FDE1           	LDA	LAB_2CEE-1,X	; get byte from table
C11F  95 BB             	STA	LAB_IGBY-1,X	; save byte in page zero
C121  CA                	DEX				; decrement count
C122  D0 F8             	BNE	LAB_2D4E		; loop if not all done

                        ; copy block from StrTab to $0000 - $0012

C124                    LAB_GMEM
C124  A2 12             	LDX	#EndTab-StrTab-1	; set byte count-1
C126                    TabLoop
C126  BD 1AE2           	LDA	StrTab,X		; get byte from table
C129  95 00             	STA	PLUS_0,X		; save byte in page zero
C12B  CA                	DEX				; decrement count
C12C  10 F8             	BPL	TabLoop		; loop if not all done

                        ; set-up start values

C12E  A9 00             	LDA	#$00			; clear A
C130  85 DC             	STA	NmiBase		; clear NMI handler enabled flag
C132  85 DF             	STA	IrqBase		; clear IRQ handler enabled flag
C134  85 B2             	STA	FAC1_o		; clear FAC1 overflow byte
C136  85 67             	STA	last_sh		; clear descriptor stack top item pointer high byte

C138  A9 0E             	LDA	#$0E			; set default tab size
C13A  85 64             	STA	TabSiz		; save it
C13C  A9 03             	LDA	#$03			; set garbage collect step size for descriptor stack
C13E  85 A0             	STA	g_step		; save it
C140  A2 68             	LDX	#des_sk		; descriptor stack start
C142  86 65             	STX	next_s		; set descriptor stack pointer
C144  20 A3C9           	JSR	LAB_CRLF		; print CR/LF
C147  A9 2D             	LDA	#<LAB_MSZM		; point to memory size message (low addr)
C149  A0 E2             	LDY	#>LAB_MSZM		; point to memory size message (high addr)
C14B  20 E4C9           	JSR	LAB_18C3		; print null terminated string from memory
C14E  20 46C3           	JSR	LAB_INLN		; print "? " and get BASIC input
C151  86 C3             	STX	Bpntrl		; set BASIC execute pointer low byte
C153  84 C4             	STY	Bpntrh		; set BASIC execute pointer high byte
C155  20 C200           	JSR	LAB_GBYT		; get last byte back

C158  D0 1F             	BNE	LAB_2DAA		; branch if not null (user typed something)

C15A  A0 00             	LDY	#$00			; else clear Y
                        					; character was null so get memory size the hard way
                        					; we get here with Y=0 and Itempl/h = Ram_base
C15C                    LAB_2D93
C15C  E6 11             	INC	Itempl		; increment temporary integer low byte
C15E  D0 08             	BNE	LAB_2D99		; branch if no overflow

C160  E6 12             	INC	Itemph		; increment temporary integer high byte
C162  A5 12             	LDA	Itemph		; get high byte
C164  C9 80             	CMP	#>Ram_top		; compare with top of RAM+1
C166  F0 1D             	BEQ	LAB_2DB6		; branch if match (end of user RAM)

C168                    LAB_2D99
C168  A9 55             	LDA	#$55			; set test byte
C16A  91 11             	STA	(Itempl),Y		; save via temporary integer
C16C  D1 11             	CMP	(Itempl),Y		; compare via temporary integer
C16E  D0 15             	BNE	LAB_2DB6		; branch if fail

C170  0A                	ASL				; shift test byte left (now $AA)
C171  91 11             	STA	(Itempl),Y		; save via temporary integer
C173  D1 11             	CMP	(Itempl),Y		; compare via temporary integer
C175  F0 E5             	BEQ	LAB_2D93		; if ok go do next byte

C177  D0 0C             	BNE	LAB_2DB6		; branch if fail

C179                    LAB_2DAA
C179  20 B7DA           	JSR	LAB_2887		; get FAC1 from string
C17C  A5 AC             	LDA	FAC1_e		; get FAC1 exponent
C17E  C9 98             	CMP	#$98			; compare with exponent = 2^24
C180  B0 A2             	BCS	LAB_GMEM		; if too large go try again

C182  20 08D6           	JSR	LAB_F2FU		; save integer part of FAC1 in temporary integer
                        					; (no range check)

C185                    LAB_2DB6
C185  A5 11             	LDA	Itempl		; get temporary integer low byte
C187  A4 12             	LDY	Itemph		; get temporary integer high byte
C189  C0 01             	CPY	#<Ram_base+1	; compare with start of RAM+$100 high byte
C18B  90 97             	BCC	LAB_GMEM		; if too small go try again


                        ; uncomment these lines if you want to check on the high limit of memory. Note if
                        ; Ram_top is set too low then this will fail. default is ignore it and assume the
                        ; users know what they're doing!

                        ;	CPY	#>Ram_top		; compare with top of RAM high byte
                        ;	BCC	MEM_OK		; branch if < RAM top

                        ;	BNE	LAB_GMEM		; if too large go try again
                        					; else was = so compare low bytes
                        ;	CMP	#<Ram_top		; compare with top of RAM low byte
                        ;	BEQ	MEM_OK		; branch if = RAM top

                        ;	BCS	LAB_GMEM		; if too large go try again

                        ;MEM_OK
C18D  85 85             	STA	Ememl			; set end of mem low byte
C18F  84 86             	STY	Ememh			; set end of mem high byte
C191  85 81             	STA	Sstorl		; set bottom of string space low byte
C193  84 82             	STY	Sstorh		; set bottom of string space high byte

C195  A0 00             	LDY	#<Ram_base		; set start addr low byte
C197  A2 04             	LDX	#>Ram_base		; set start addr high byte
C199  84 79             	STY	Smeml			; save start of mem low byte
C19B  86 7A             	STX	Smemh			; save start of mem high byte

                        ; this line is only needed if Ram_base is not $xx00

                        ;	LDY	#$00			; clear Y
C19D  98                	TYA				; clear A
C19E  91 79             	STA	(Smeml),Y		; clear first byte
C1A0  E6 79             	INC	Smeml			; increment start of mem low byte

                        ; these two lines are only needed if Ram_base is $xxFF

                        ;	BNE	LAB_2E05		; branch if no rollover

                        ;	INC	Smemh			; increment start of mem high byte
C1A2                    LAB_2E05
C1A2  20 A3C9           	JSR	LAB_CRLF		; print CR/LF
C1A5  20 5EC4           	JSR	LAB_1463		; do "NEW" and "CLEAR"
C1A8  A5 85             	LDA	Ememl			; get end of mem low byte
C1AA  38                	SEC				; set carry for subtract
C1AB  E5 79             	SBC	Smeml			; subtract start of mem low byte
C1AD  AA                	TAX				; copy to X
C1AE  A5 86             	LDA	Ememh			; get end of mem high byte
C1B0  E5 7A             	SBC	Smemh			; subtract start of mem high byte
C1B2  20 93DB           	JSR	LAB_295E		; print XA as unsigned integer (bytes free)
C1B5  A9 3C             	LDA	#<LAB_SMSG		; point to sign-on message (low addr)
C1B7  A0 E2             	LDY	#>LAB_SMSG		; point to sign-on message (high addr)
C1B9  20 E4C9           	JSR	LAB_18C3		; print null terminated string from memory
C1BC  A9 60             	LDA	#<LAB_1274		; warm start vector low byte
C1BE  A0 C2             	LDY	#>LAB_1274		; warm start vector high byte
C1C0  85 01             	STA	Wrmjpl		; save warm start vector low byte
C1C2  84 02             	STY	Wrmjph		; save warm start vector high byte
C1C4  6C 0100           	JMP	(Wrmjpl)		; go do warm start

                        ; open up space in memory
                        ; move (Ostrtl)-(Obendl) to new block ending at (Nbendl)

                        ; Nbendl,Nbendh - new block end address (A/Y)
                        ; Obendl,Obendh - old block end address
                        ; Ostrtl,Ostrth - old block start address

                        ; returns with ..

                        ; Nbendl,Nbendh - new block start address (high byte - $100)
                        ; Obendl,Obendh - old block start address (high byte - $100)
                        ; Ostrtl,Ostrth - old block start address (unchanged)

C1C7                    LAB_11CF
C1C7  20 11C2           	JSR	LAB_121F		; check available memory, "Out of memory" error if no room
                        					; addr to check is in AY (low/high)
C1CA  85 7F             	STA	Earryl		; save new array mem end low byte
C1CC  84 80             	STY	Earryh		; save new array mem end high byte

                        ; open up space in memory
                        ; move (Ostrtl)-(Obendl) to new block ending at (Nbendl)
                        ; don't set array end

C1CE                    LAB_11D6
C1CE  38                	SEC				; set carry for subtract
C1CF  A5 A6             	LDA	Obendl		; get block end low byte
C1D1  E5 AA             	SBC	Ostrtl		; subtract block start low byte
C1D3  A8                	TAY				; copy MOD(block length/$100) byte to Y
C1D4  A5 A7             	LDA	Obendh		; get block end high byte
C1D6  E5 AB             	SBC	Ostrth		; subtract block start high byte
C1D8  AA                	TAX				; copy block length high byte to X
C1D9  E8                	INX				; +1 to allow for count=0 exit
C1DA  98                	TYA				; copy block length low byte to A
C1DB  F0 24             	BEQ	LAB_120A		; branch if length low byte=0

                        					; block is (X-1)*256+Y bytes, do the Y bytes first

C1DD  38                	SEC				; set carry for add + 1, two's complement
C1DE  49 FF             	EOR	#$FF			; invert low byte for subtract
C1E0  65 A6             	ADC	Obendl		; add block end low byte

C1E2  85 A6             	STA	Obendl		; save corrected old block end low byte
C1E4  B0 03             	BCS	LAB_11F3		; branch if no underflow

C1E6  C6 A7             	DEC	Obendh		; else decrement block end high byte
C1E8  38                	SEC				; set carry for add + 1, two's complement
C1E9                    LAB_11F3
C1E9  98                	TYA				; get MOD(block length/$100) byte
C1EA  49 FF             	EOR	#$FF			; invert low byte for subtract
C1EC  65 A4             	ADC	Nbendl		; add destination end low byte
C1EE  85 A4             	STA	Nbendl		; save modified new block end low byte
C1F0  B0 08             	BCS	LAB_1203		; branch if no underflow

C1F2  C6 A5             	DEC	Nbendh		; else decrement block end high byte
C1F4  90 04             	BCC	LAB_1203		; branch always

C1F6                    LAB_11FF
C1F6  B1 A6             	LDA	(Obendl),Y		; get byte from source
C1F8  91 A4             	STA	(Nbendl),Y		; copy byte to destination
C1FA                    LAB_1203
C1FA  88                	DEY				; decrement index
C1FB  D0 F9             	BNE	LAB_11FF		; loop until Y=0

                        					; now do Y=0 indexed byte
C1FD  B1 A6             	LDA	(Obendl),Y		; get byte from source
C1FF  91 A4             	STA	(Nbendl),Y		; save byte to destination
C201                    LAB_120A
C201  C6 A7             	DEC	Obendh		; decrement source pointer high byte
C203  C6 A5             	DEC	Nbendh		; decrement destination pointer high byte
C205  CA                	DEX				; decrement block count
C206  D0 F2             	BNE	LAB_1203		; loop until count = $0

C208  60                	RTS

                        ; check room on stack for A bytes
                        ; stack too deep? do OM error

C209                    LAB_1212
C209  85 78             	STA	TempB			; save result in temp byte
C20B  BA                	TSX				; copy stack
C20C  E4 78             	CPX	TempB			; compare new "limit" with stack
C20E  90 30             	BCC	LAB_OMER		; if stack < limit do "Out of memory" error then warm start

C210  60                	RTS

                        ; check available memory, "Out of memory" error if no room
                        ; addr to check is in AY (low/high)

C211                    LAB_121F
C211  C4 82             	CPY	Sstorh		; compare bottom of string mem high byte
C213  90 2A             	BCC	LAB_124B		; if less then exit (is ok)

C215  D0 04             	BNE	LAB_1229		; skip next test if greater (tested <)

                        					; high byte was =, now do low byte
C217  C5 81             	CMP	Sstorl		; compare with bottom of string mem low byte
C219  90 24             	BCC	LAB_124B		; if less then exit (is ok)

                        					; addr is > string storage ptr (oops!)
C21B                    LAB_1229
C21B  48                	PHA				; push addr low byte
C21C  A2 08             	LDX	#$08			; set index to save Adatal to expneg inclusive
C21E  98                	TYA				; copy addr high byte (to push on stack)

                        					; save misc numeric work area
C21F                    LAB_122D
C21F  48                	PHA				; push byte
C220  B5 A3             	LDA	Adatal-1,X		; get byte from Adatal to expneg ( ,$00 not pushed)
C222  CA                	DEX				; decrement index
C223  10 FA             	BPL	LAB_122D		; loop until all done

C225  20 F0D2           	JSR	LAB_GARB		; garbage collection routine

                        					; restore misc numeric work area
C228  A2 00             	LDX	#$00			; clear the index to restore bytes
C22A                    LAB_1238
C22A  68                	PLA				; pop byte
C22B  95 A4             	STA	Adatal,X		; save byte to Adatal to expneg
C22D  E8                	INX				; increment index
C22E  E0 08             	CPX	#$08			; compare with end + 1
C230  30 F8             	BMI	LAB_1238		; loop if more to do

C232  68                	PLA				; pop addr high byte
C233  A8                	TAY				; copy back to Y
C234  68                	PLA				; pop addr low byte
C235  C4 82             	CPY	Sstorh		; compare bottom of string mem high byte
C237  90 06             	BCC	LAB_124B		; if less then exit (is ok)

C239  D0 05             	BNE	LAB_OMER		; if greater do "Out of memory" error then warm start

                        					; high byte was =, now do low byte
C23B  C5 81             	CMP	Sstorl		; compare with bottom of string mem low byte
C23D  B0 01             	BCS	LAB_OMER		; if >= do "Out of memory" error then warm start

                        					; ok exit, carry clear
C23F                    LAB_124B
C23F  60                	RTS

                        ; do "Out of memory" error then warm start

C240                    LAB_OMER
C240  A2 0C             	LDX	#$0C			; error code $0C ("Out of memory" error)

                        ; do error #X, then warm start

C242                    LAB_XERR
C242  20 A3C9           	JSR	LAB_CRLF		; print CR/LF

C245  BD B5E7           	LDA	LAB_BAER,X		; get error message pointer low byte
C248  BC B6E7           	LDY	LAB_BAER+1,X	; get error message pointer high byte
C24B  20 E4C9           	JSR	LAB_18C3		; print null terminated string from memory

C24E  20 97C4           	JSR	LAB_1491		; flush stack and clear continue flag
C251  A9 F2             	LDA	#<LAB_EMSG		; point to " Error" low addr
C253  A0 E8             	LDY	#>LAB_EMSG		; point to " Error" high addr
C255                    LAB_1269
C255  20 E4C9           	JSR	LAB_18C3		; print null terminated string from memory
C258  A4 88             	LDY	Clineh		; get current line high byte
C25A  C8                	INY				; increment it
C25B  F0 03             	BEQ	LAB_1274		; go do warm start (was immediate mode)

                        					; else print line number
C25D  20 88DB           	JSR	LAB_2953		; print " in line [LINE #]"

                        ; BASIC warm start entry point
                        ; wait for Basic command

C260                    LAB_1274
                        					; clear ON IRQ/NMI bytes
C260  A9 00             	LDA	#$00			; clear A
C262  85 DF             	STA	IrqBase		; clear enabled byte
C264  85 DC             	STA	NmiBase		; clear enabled byte
C266  A9 03             	LDA	#<LAB_RMSG		; point to "Ready" message low byte
C268  A0 E9             	LDY	#>LAB_RMSG		; point to "Ready" message high byte

C26A  20 E4C9           	JSR	LAB_18C3		; go do print string

                        ; wait for Basic command (no "Ready")

C26D                    LAB_127D
C26D  20 53C3           	JSR	LAB_1357		; call for BASIC input
C270                    LAB_1280
C270  86 C3             	STX	Bpntrl		; set BASIC execute pointer low byte
C272  84 C4             	STY	Bpntrh		; set BASIC execute pointer high byte
C274  20 C200           	JSR	LAB_GBYT		; scan memory
C277  F0 F4             	BEQ	LAB_127D		; loop while null

                        ; got to interpret input line now ..

C279  A2 FF             	LDX	#$FF			; current line to null value
C27B  86 88             	STX	Clineh		; set current line high byte
C27D  90 06             	BCC	LAB_1295		; branch if numeric character (handle new BASIC line)

                        					; no line number .. immediate mode
C27F  20 86C3           	JSR	LAB_13A6		; crunch keywords into Basic tokens
C282  4C 04C6           	JMP	LAB_15F6		; go scan and interpret code

                        ; handle new BASIC line

C285                    LAB_1295
C285  20 66C8           	JSR	LAB_GFPN		; get fixed-point number into temp integer
C288  20 86C3           	JSR	LAB_13A6		; crunch keywords into Basic tokens
C28B  84 5D             	STY	Ibptr			; save index pointer to end of crunched line
C28D  20 32C4           	JSR	LAB_SSLN		; search BASIC for temp integer line number
C290  90 44             	BCC	LAB_12E6		; branch if not found

                        					; aroooogah! line # already exists! delete it
C292  A0 01             	LDY	#$01			; set index to next line pointer high byte
C294  B1 AA             	LDA	(Baslnl),Y		; get next line pointer high byte
C296  85 72             	STA	ut1_ph		; save it
C298  A5 7B             	LDA	Svarl			; get start of vars low byte
C29A  85 71             	STA	ut1_pl		; save it
C29C  A5 AB             	LDA	Baslnh		; get found line pointer high byte
C29E  85 74             	STA	ut2_ph		; save it
C2A0  A5 AA             	LDA	Baslnl		; get found line pointer low byte
C2A2  88                	DEY				; decrement index
C2A3  F1 AA             	SBC	(Baslnl),Y		; subtract next line pointer low byte
C2A5  18                	CLC				; clear carry for add
C2A6  65 7B             	ADC	Svarl			; add start of vars low byte
C2A8  85 7B             	STA	Svarl			; save new start of vars low byte
C2AA  85 73             	STA	ut2_pl		; save destination pointer low byte
C2AC  A5 7C             	LDA	Svarh			; get start of vars high byte
C2AE  69 FF             	ADC	#$FF			; -1 + carry
C2B0  85 7C             	STA	Svarh			; save start of vars high byte
C2B2  E5 AB             	SBC	Baslnh		; subtract found line pointer high byte
C2B4  AA                	TAX				; copy to block count
C2B5  38                	SEC				; set carry for subtract
C2B6  A5 AA             	LDA	Baslnl		; get found line pointer low byte
C2B8  E5 7B             	SBC	Svarl			; subtract start of vars low byte
C2BA  A8                	TAY				; copy to bytes in first block count
C2BB  B0 03             	BCS	LAB_12D0		; branch if overflow

C2BD  E8                	INX				; increment block count (correct for =0 loop exit)
C2BE  C6 74             	DEC	ut2_ph		; decrement destination high byte
C2C0                    LAB_12D0
C2C0  18                	CLC				; clear carry for add
C2C1  65 71             	ADC	ut1_pl		; add source pointer low byte
C2C3  90 03             	BCC	LAB_12D8		; branch if no overflow

C2C5  C6 72             	DEC	ut1_ph		; else decrement source pointer high byte
C2C7  18                	CLC				; clear carry

                        					; close up memory to delete old line
C2C8                    LAB_12D8
C2C8  B1 71             	LDA	(ut1_pl),Y		; get byte from source
C2CA  91 73             	STA	(ut2_pl),Y		; copy to destination
C2CC  C8                	INY				; increment index
C2CD  D0 F9             	BNE	LAB_12D8		; while <> 0 do this block

C2CF  E6 72             	INC	ut1_ph		; increment source pointer high byte
C2D1  E6 74             	INC	ut2_ph		; increment destination pointer high byte
C2D3  CA                	DEX				; decrement block count
C2D4  D0 F2             	BNE	LAB_12D8		; loop until all done

                        					; got new line in buffer and no existing same #
C2D6                    LAB_12E6
C2D6  AD 2102           	LDA	Ibuffs		; get byte from start of input buffer
C2D9  F0 3F             	BEQ	LAB_1319		; if null line just go flush stack/vars and exit

                        					; got new line and it isn't empty line
C2DB  A5 85             	LDA	Ememl			; get end of mem low byte
C2DD  A4 86             	LDY	Ememh			; get end of mem high byte
C2DF  85 81             	STA	Sstorl		; set bottom of string space low byte
C2E1  84 82             	STY	Sstorh		; set bottom of string space high byte
C2E3  A5 7B             	LDA	Svarl			; get start of vars low byte	(end of BASIC)
C2E5  85 A6             	STA	Obendl		; save old block end low byte
C2E7  A4 7C             	LDY	Svarh			; get start of vars high byte	(end of BASIC)
C2E9  84 A7             	STY	Obendh		; save old block end high byte
