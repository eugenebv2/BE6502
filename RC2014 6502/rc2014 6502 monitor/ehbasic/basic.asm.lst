CF07  A6 7C             	LDX	Svarh			; get start of vars high byte
CF09  A0 00             	LDY	#$00			; clear index
CF0B                    LAB_1D5D
CF0B  86 AB             	STX	Vrschh		; save search address high byte
CF0D                    LAB_1D5F
CF0D  85 AA             	STA	Vrschl		; save search address low byte
