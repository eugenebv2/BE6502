CD81                    LAB_LRMS
CD81  20 FACB           	JSR	LAB_EVEZ		; evaluate (should be string) expression
CD84  20 0FCD           	JSR	LAB_1C01		; scan for ",", else do syntax error then warm start
CD87  20 E3CB           	JSR	LAB_CTST		; check if source is string, else do type mismatch

CD8A  68                	PLA				; get function jump vector low byte
CD8B  AA                	TAX				; save functions jump vector low byte
CD8C  68                	PLA				; get function jump vector high byte
CD8D  A8                	TAY				; save functions jump vector high byte
CD8E  A5 AF             	LDA	des_ph		; get descriptor pointer high byte
CD90  48                	PHA				; push string pointer high byte
CD91  A5 AE             	LDA	des_pl		; get descriptor pointer low byte
CD93  48                	PHA				; push string pointer low byte
CD94  98                	TYA				; get function jump vector high byte back
CD95  48                	PHA				; save functions jump vector high byte
CD96  8A                	TXA				; get function jump vector low byte back
CD97  48                	PHA				; save functions jump vector low byte
CD98  20 9DD5           	JSR	LAB_GTBY		; get byte parameter
CD9B  8A                	TXA				; copy byte parameter to A
CD9C  60                	RTS				; go do function

