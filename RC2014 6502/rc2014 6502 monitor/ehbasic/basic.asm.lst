CEB3  86 78             	STX	TempB			; save it
CEB5  20 D4D6           	JSR	LAB_279B		; copy FAC2 to FAC1 (get 2nd value in expression)
CEB8  4C B7CF           	JMP	LAB_EVIR		; evaluate integer expression (no sign check)

