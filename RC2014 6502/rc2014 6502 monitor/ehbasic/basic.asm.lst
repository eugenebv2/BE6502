E05B  A5 AA             	LDA	Baslnl		; get pointer low byte
E05D  E9 01             	SBC	#$01			; -1 (carry already set for subtract)
E05F  95 01             	STA	PLUS_1,X		; save as interrupt pointer low byte
E061  A5 AB             	LDA	Baslnh		; get pointer high byte
E063  E9 00             	SBC	#$00			; subtract carry
E065  95 02             	STA	PLUS_2,X		; save as interrupt pointer high byte

E067  A9 C0             	LDA	#$C0			; set interrupt enabled/setup bits
E069  95 00             	STA	PLUS_0,X		; set interrupt flags
E06B                    LAB_IRTS
E06B  60                	RTS

                        ; return from IRQ service, restores the enabled flag.

                        ; perform RETIRQ

E06C                    LAB_RETIRQ
E06C  D0 FD             	BNE	LAB_IRTS		; exit if following token (to allow syntax error)

E06E  A5 DF             	LDA	IrqBase		; get interrupt flags
E070  0A                	ASL				; copy setup to enabled (b7)
E071  05 DF             	ORA	IrqBase		; OR in setup flag
E073  85 DF             	STA	IrqBase		; save enabled flag
E075  4C 8AC7           	JMP	LAB_16E8		; go do rest of RETURN

                        ; return from NMI service, restores the enabled flag.

                        ; perform RETNMI

E078                    LAB_RETNMI
E078  D0 F1             	BNE	LAB_IRTS		; exit if following token (to allow syntax error)

E07A  A5 DC             	LDA	NmiBase		; get set-up flag
E07C  0A                	ASL				; copy setup to enabled (b7)
E07D  05 DC             	ORA	NmiBase		; OR in setup flag
E07F  85 DC             	STA	NmiBase		; save enabled flag
E081  4C 8AC7           	JMP	LAB_16E8		; go do rest of RETURN

                        ; MAX() MIN() pre process

E084                    LAB_MMPP
E084  20 FACB           	JSR	LAB_EVEZ		; process expression
E087  4C E1CB           	JMP	LAB_CTNM		; check if source is numeric, else do type mismatch

                        ; perform MAX()

E08A                    LAB_MAX
E08A  20 B8E0           	JSR	LAB_PHFA		; push FAC1, evaluate expression,
                        					; pull FAC2 and compare with FAC1
E08D  10 FB             	BPL	LAB_MAX		; branch if no swap to do

E08F  A5 B4             	LDA	FAC2_1		; get FAC2 mantissa1
E091  09 80             	ORA	#$80			; set top bit (clear sign from compare)
E093  85 B4             	STA	FAC2_1		; save FAC2 mantissa1
E095  20 D4D6           	JSR	LAB_279B		; copy FAC2 to FAC1
E098  F0 F0             	BEQ	LAB_MAX		; go do next (branch always)

                        ; perform MIN()

E09A                    LAB_MIN
E09A  20 B8E0           	JSR	LAB_PHFA		; push FAC1, evaluate expression,
                        					; pull FAC2 and compare with FAC1
E09D  30 FB             	BMI	LAB_MIN		; branch if no swap to do

E09F  F0 F9             	BEQ	LAB_MIN		; branch if no swap to do

E0A1  A5 B4             	LDA	FAC2_1		; get FAC2 mantissa1
E0A3  09 80             	ORA	#$80			; set top bit (clear sign from compare)
E0A5  85 B4             	STA	FAC2_1		; save FAC2 mantissa1
E0A7  20 D4D6           	JSR	LAB_279B		; copy FAC2 to FAC1
E0AA  F0 EE             	BEQ	LAB_MIN		; go do next (branch always)

                        ; exit routine. don't bother returning to the loop code
                        ; check for correct exit, else so syntax error

E0AC                    LAB_MMEC
E0AC  C9 29             	CMP	#')'			; is it end of function?
E0AE  D0 05             	BNE	LAB_MMSE		; if not do MAX MIN syntax error

E0B0  68                	PLA				; dump return address low byte
E0B1  68                	PLA				; dump return address high byte
E0B2  4C BC00           	JMP	LAB_IGBY		; update BASIC execute pointer (to chr past ")")

E0B5                    LAB_MMSE
E0B5  4C 13CD           	JMP	LAB_SNER		; do syntax error then warm start

                        ; check for next, evaluate and return or exit
                        ; this is the routine that does most of the work

E0B8                    LAB_PHFA
E0B8  20 C200           	JSR	LAB_GBYT		; get next BASIC byte
E0BB  C9 2C             	CMP	#','			; is there more ?
E0BD  D0 ED             	BNE	LAB_MMEC		; if not go do end check

                        					; push FAC1
E0BF  20 EAD9           	JSR	LAB_27BA		; round FAC1
E0C2  A5 B0             	LDA	FAC1_s		; get FAC1 sign
E0C4  09 7F             	ORA	#$7F			; set all non sign bits
E0C6  25 AD             	AND	FAC1_1		; AND FAC1 mantissa1 (AND in sign bit)
E0C8  48                	PHA				; push on stack
E0C9  A5 AE             	LDA	FAC1_2		; get FAC1 mantissa2
E0CB  48                	PHA				; push on stack
E0CC  A5 AF             	LDA	FAC1_3		; get FAC1 mantissa3
E0CE  48                	PHA				; push on stack
E0CF  A5 AC             	LDA	FAC1_e		; get FAC1 exponent
E0D1  48                	PHA				; push on stack

E0D2  20 BC00           	JSR	LAB_IGBY		; scan and get next BASIC byte (after ",")
E0D5  20 DECB           	JSR	LAB_EVNM		; evaluate expression and check is numeric,
                        					; else do type mismatch

                        					; pop FAC2 (MAX/MIN expression so far)
E0D8  68                	PLA				; pop exponent
E0D9  85 B3             	STA	FAC2_e		; save FAC2 exponent
E0DB  68                	PLA				; pop mantissa3
E0DC  85 B6             	STA	FAC2_3		; save FAC2 mantissa3
E0DE  68                	PLA				; pop mantissa1
E0DF  85 B5             	STA	FAC2_2		; save FAC2 mantissa2
E0E1  68                	PLA				; pop sign/mantissa1
E0E2  85 B4             	STA	FAC2_1		; save FAC2 sign/mantissa1
E0E4  85 B7             	STA	FAC2_s		; save FAC2 sign

                        					; compare FAC1 with (packed) FAC2
E0E6  A9 B3             	LDA	#<FAC2_e		; set pointer low byte to FAC2
E0E8  A0 00             	LDY	#>FAC2_e		; set pointer high byte to FAC2
E0EA  4C 28DA           	JMP	LAB_27F8		; compare FAC1 with FAC2 (AY) and return
                        					; returns A=$00 if FAC1 = (AY)
                        					; returns A=$01 if FAC1 > (AY)
                        					; returns A=$FF if FAC1 < (AY)

                        ; perform WIDTH

E0ED                    LAB_WDTH
E0ED  C9 2C             	CMP	#','			; is next byte ","
E0EF  F0 1B             	BEQ	LAB_TBSZ		; if so do tab size

E0F1  20 9DD5           	JSR	LAB_GTBY		; get byte parameter
E0F4  8A                	TXA				; copy width to A
E0F5  F0 0A             	BEQ	LAB_NSTT		; branch if set for infinite line

E0F7  E0 10             	CPX	#$10			; else make min width = 16d
E0F9  90 45             	BCC	TabErr		; if less do function call error and exit

                        ; this next compare ensures that we can't exit WIDTH via an error leaving the
                        ; tab size greater than the line length.

E0FB  E4 64             	CPX	TabSiz		; compare with tab size
E0FD  B0 02             	BCS	LAB_NSTT		; branch if >= tab size

E0FF  86 64             	STX	TabSiz		; else make tab size = terminal width
E101                    LAB_NSTT
E101  86 0F             	STX	TWidth		; set the terminal width
E103  20 C200           	JSR	LAB_GBYT		; get BASIC byte back
E106  F0 1A             	BEQ	WExit			; exit if no following

E108  C9 2C             	CMP	#','			; else is it ","
E10A  D0 A9             	BNE	LAB_MMSE		; if not do syntax error

E10C                    LAB_TBSZ
E10C  20 9AD5           	JSR	LAB_SGBY		; scan and get byte parameter
E10F  8A                	TXA				; copy TAB size
E110  30 2E             	BMI	TabErr		; if >127 do function call error and exit

E112  E0 01             	CPX	#$01			; compare with min-1
E114  90 2A             	BCC	TabErr		; if <=1 do function call error and exit

E116  A5 0F             	LDA	TWidth		; set flags for width
E118  F0 06             	BEQ	LAB_SVTB		; skip check if infinite line

E11A  E4 0F             	CPX	TWidth		; compare TAB with width
E11C  F0 02             	BEQ	LAB_SVTB		; ok if =

E11E  B0 20             	BCS	TabErr		; branch if too big

E120                    LAB_SVTB
E120  86 64             	STX	TabSiz		; save TAB size

                        ; calculate tab column limit from TAB size. The Iclim is set to the last tab
                        ; position on a line that still has at least one whole tab width between it
                        ; and the end of the line.

E122                    WExit
E122  A5 0F             	LDA	TWidth		; get width
E124  F0 06             	BEQ	LAB_SULP		; branch if infinite line

E126  C5 64             	CMP	TabSiz		; compare with tab size
E128  B0 03             	BCS	LAB_WDLP		; branch if >= tab size

E12A  85 64             	STA	TabSiz		; else make tab size = terminal width
E12C                    LAB_SULP
E12C  38                	SEC				; set carry for subtract
E12D                    LAB_WDLP
E12D  E5 64             	SBC	TabSiz		; subtract tab size
E12F  B0 FC             	BCS	LAB_WDLP		; loop while no borrow

E131  65 64             	ADC	TabSiz		; add tab size back
E133  18                	CLC				; clear carry for add
E134  65 64             	ADC	TabSiz		; add tab size back again
E136  85 10             	STA	Iclim			; save for now
E138  A5 0F             	LDA	TWidth		; get width back
E13A  38                	SEC				; set carry for subtract
E13B  E5 10             	SBC	Iclim			; subtract remainder
E13D  85 10             	STA	Iclim			; save tab column limit
E13F                    LAB_NOSQ
E13F  60                	RTS

E140                    TabErr
E140  4C 3AD0           	JMP	LAB_FCER		; do function call error then warm start

                        ; perform SQR()

E143                    LAB_SQR
E143  A5 B0             	LDA	FAC1_s		; get FAC1 sign
E145  30 F9             	BMI	TabErr		; if -ve do function call error

E147  A5 AC             	LDA	FAC1_e		; get exponent
E149  F0 F4             	BEQ	LAB_NOSQ		; if zero just return

                        					; else do root
E14B  20 DBD9           	JSR	LAB_27AB		; round and copy FAC1 to FAC2
E14E  A9 00             	LDA	#$00			; clear A

E150  85 77             	STA	FACt_3		; clear remainder
E152  85 76             	STA	FACt_2		; ..
E154  85 75             	STA	FACt_1		; ..
E156  85 78             	STA	TempB			; ..

E158  85 AF             	STA	FAC1_3		; clear root
E15A  85 AE             	STA	FAC1_2		; ..
E15C  85 AD             	STA	FAC1_1		; ..

E15E  A2 18             	LDX	#$18			; 24 pairs of bits to do
E160  A5 B3             	LDA	FAC2_e		; get exponent
E162  4A                	LSR				; check odd/even
E163  B0 0E             	BCS	LAB_SQE2		; if odd only 1 shift first time

E165                    LAB_SQE1
E165  06 B6             	ASL	FAC2_3		; shift highest bit of number ..
E167  26 B5             	ROL	FAC2_2		; ..
E169  26 B4             	ROL	FAC2_1		; ..
E16B  26 77             	ROL	FACt_3		; .. into remainder
E16D  26 76             	ROL	FACt_2		; ..
E16F  26 75             	ROL	FACt_1		; ..
E171  26 78             	ROL	TempB			; .. never overflows
E173                    LAB_SQE2
E173  06 B6             	ASL	FAC2_3		; shift highest bit of number ..
E175  26 B5             	ROL	FAC2_2		; ..
E177  26 B4             	ROL	FAC2_1		; ..
E179  26 77             	ROL	FACt_3		; .. into remainder
E17B  26 76             	ROL	FACt_2		; ..
E17D  26 75             	ROL	FACt_1		; ..
E17F  26 78             	ROL	TempB			; .. never overflows

E181  06 AF             	ASL	FAC1_3		; root = root * 2
E183  26 AE             	ROL	FAC1_2		; ..
E185  26 AD             	ROL	FAC1_1		; .. never overflows

E187  A5 AF             	LDA	FAC1_3		; get root low byte
E189  2A                	ROL				; *2
E18A  85 5B             	STA	Temp3			; save partial low byte
E18C  A5 AE             	LDA	FAC1_2		; get root low mid byte
E18E  2A                	ROL				; *2
E18F  85 5C             	STA	Temp3+1		; save partial low mid byte
E191  A5 AD             	LDA	FAC1_1		; get root high mid byte
E193  2A                	ROL				; *2
E194  85 5D             	STA	Temp3+2		; save partial high mid byte
E196  A9 00             	LDA	#$00			; get root high byte (always $00)
E198  2A                	ROL				; *2
E199  85 5E             	STA	Temp3+3		; save partial high byte

                        					; carry clear for subtract +1
E19B  A5 77             	LDA	FACt_3		; get remainder low byte
E19D  E5 5B             	SBC	Temp3			; subtract partial low byte
E19F  85 5B             	STA	Temp3			; save partial low byte

E1A1  A5 76             	LDA	FACt_2		; get remainder low mid byte
E1A3  E5 5C             	SBC	Temp3+1		; subtract partial low mid byte
E1A5  85 5C             	STA	Temp3+1		; save partial low mid byte

E1A7  A5 75             	LDA	FACt_1		; get remainder high mid byte
E1A9  E5 5D             	SBC	Temp3+2		; subtract partial high mid byte
E1AB  A8                	TAY				; copy partial high mid byte

E1AC  A5 78             	LDA	TempB			; get remainder high byte
E1AE  E5 5E             	SBC	Temp3+3		; subtract partial high byte
E1B0  90 0E             	BCC	LAB_SQNS		; skip sub if remainder smaller

E1B2  85 78             	STA	TempB			; save remainder high byte

E1B4  84 75             	STY	FACt_1		; save remainder high mid byte

E1B6  A5 5C             	LDA	Temp3+1		; get remainder low mid byte
E1B8  85 76             	STA	FACt_2		; save remainder low mid byte

E1BA  A5 5B             	LDA	Temp3			; get partial low byte
E1BC  85 77             	STA	FACt_3		; save remainder low byte

E1BE  E6 AF             	INC	FAC1_3		; increment root low byte (never any rollover)
E1C0                    LAB_SQNS
E1C0  CA                	DEX				; decrement bit pair count
E1C1  D0 A2             	BNE	LAB_SQE1		; loop if not all done

E1C3  38                	SEC				; set carry for subtract
E1C4  A5 B3             	LDA	FAC2_e		; get exponent
E1C6  E9 80             	SBC	#$80			; normalise
E1C8  6A                	ROR				; /2 and re-bias to $80
E1C9  69 00             	ADC	#$00			; add bit zero back in (allow for half shift)
E1CB  85 AC             	STA	FAC1_e		; save it
E1CD  4C 45D7           	JMP	LAB_24D5		; normalise FAC1 and return

                        ; perform VARPTR()

E1D0                    LAB_VARPTR
E1D0  20 BC00           	JSR	LAB_IGBY		; increment and scan memory
E1D3  20 BBCE           	JSR	LAB_GVAR		; get var address
E1D6  20 00CD           	JSR	LAB_1BFB		; scan for ")" , else do syntax error then warm start
E1D9  A4 95             	LDY	Cvaral		; get var address low byte
E1DB  A5 96             	LDA	Cvarah		; get var address high byte
E1DD  4C 6AD1           	JMP	LAB_AYFC		; save and convert integer AY to FAC1 and return

                        ; perform PI

E1E0                    LAB_PI
E1E0  A9 BE             	LDA	#<LAB_2C7C		; set (2*pi) pointer low byte
E1E2  A0 E2             	LDY	#>LAB_2C7C		; set (2*pi) pointer high byte
E1E4  20 8ED9           	JSR	LAB_UFAC		; unpack memory (AY) into FAC1
E1E7  C6 AC             	DEC	FAC1_e		; make result = PI
E1E9  60                	RTS

                        ; perform TWOPI

E1EA                    LAB_TWOPI
E1EA  A9 BE             	LDA	#<LAB_2C7C		; set (2*pi) pointer low byte
E1EC  A0 E2             	LDY	#>LAB_2C7C		; set (2*pi) pointer high byte
E1EE  4C 8ED9           	JMP	LAB_UFAC		; unpack memory (AY) into FAC1 and return

                        ; system dependant i/o vectors
                        ; these are in RAM and are set by the monitor at start-up

E1F1                    V_INPT
E1F1  4C 06FF           	JMP	check_input   ;(VEC_IN)		; non blocking scan input device
E1F4                    V_OUTP
E1F4  4C 09FF           	JMP	output_char   ;(VEC_OUT)	; send byte to output device
E1F7                    V_LOAD
E1F7  60                        rts
                        ;;	JMP	(VEC_LD)		; load BASIC program
E1F8                    V_SAVE
E1F8  60                        rts
                        ;;	JMP	(VEC_SV)		; save BASIC program

                        ; The rest are tables messages and code for RAM

                        ; the rest of the code is tables and BASIC start-up code

E1F9                    PG2_TABS
E1F9  00                	.byte	$00			; ctrl-c flag		-	$00 = enabled
E1FA  00                	.byte	$00			; ctrl-c byte		-	GET needs this
E1FB  00                	.byte	$00			; ctrl-c byte timeout	-	GET needs this
E1FC  B9DF              	.word	CTRLC			; ctrl c check vector
                        ;	.word	xxxx			; non halting key input	-	monitor to set this
                        ;	.word	xxxx			; output vector		-	monitor to set this
                        ;	.word	xxxx			; load vector		-	monitor to set this
                        ;	.word	xxxx			; save vector		-	monitor to set this
E1FE                    PG2_TABE

                        ; character get subroutine for zero page

                        ; For a 1.8432MHz 6502 including the JSR and RTS
                        ; fastest (>=":")	=  29 cycles =  15.7uS
                        ; slowest (<":")	=  40 cycles =  21.7uS
                        ; space skip	= +21 cycles = +11.4uS
                        ; inc across page	=  +4 cycles =  +2.2uS

                        ; the target address for the LDA at LAB_2CF4 becomes the BASIC execute pointer once the
                        ; block is copied to it's destination, any non zero page address will do at assembly
                        ; time, to assemble a three byte instruction.

                        ; page 0 initialisation table from $BC
                        ; increment and scan memory

E1FE                    LAB_2CEE
E1FE  E6 C3             	INC	Bpntrl		; increment BASIC execute pointer low byte
E200  D0 02             	BNE	LAB_2CF4		; branch if no carry
                        					; else
E202  E6 C4             	INC	Bpntrh		; increment BASIC execute pointer high byte

                        ; page 0 initialisation table from $C2
                        ; scan memory

E204                    LAB_2CF4
E204  AD FFFF           	LDA	$FFFF			; get byte to scan (addr set by call routine)
E207  C9 AD             	CMP	#TK_ELSE		; compare with the token for ELSE
E209  F0 0E             	BEQ	LAB_2D05		; exit if ELSE, not numeric, carry set

E20B  C9 3A             	CMP	#':'			; compare with ":"
E20D  B0 0A             	BCS	LAB_2D05		; exit if >= ":", not numeric, carry set

E20F  C9 20             	CMP	#' '			; compare with " "
E211  F0 EB             	BEQ	LAB_2CEE		; if " " go do next

E213  38                	SEC				; set carry for SBC
E214  E9 30             	SBC	#'0'			; subtract "0"
E216  38                	SEC				; set carry for SBC
E217  E9 D0             	SBC	#$D0			; subtract -"0"
                        					; clear carry if byte = "0"-"9"
E219                    LAB_2D05
E219  60                	RTS

                        ; page zero initialisation table $00-$12 inclusive

E21A                    StrTab
E21A  4C                	.byte	$4C			; JMP opcode
E21B  06C1              	.word LAB_COLD		; initial warm start vector (cold start)

E21D  00                	.byte	$00			; these bytes are not used by BASIC
E21E  0000              	.word	$0000			;
E220  0000              	.word	$0000			;
E222  0000              	.word	$0000			;

E224  4C                	.byte	$4C			; JMP opcode
E225  3AD0              	.word	LAB_FCER		; initial user function vector ("Function call" error)
E227  00                	.byte	$00			; default NULL count
E228  00                	.byte	$00			; clear terminal position
E229  00                	.byte	$00			; default terminal width byte
E22A  F2                	.byte	$F2			; default limit for TAB = 14
E22B  0004              	.word	Ram_base		; start of user RAM
E22D                    EndTab

E22D                    LAB_MSZM
E22D  0D0A4D65 6D6F7279 	.byte	$0D,$0A,"Memory size ",$00
E235  2073697A 652000

E23C                    LAB_SMSG
E23C  20427974 65732066 	.byte	" Bytes free",$0D,$0A,$0A
E244  7265650D 0A0A
E24A  456E6861 6E636564 	.byte	"Enhanced BASIC 2.22",$0A,$00
E252  20424153 49432032
E25A  2E32320A 00

                        ; numeric constants and series

                        					; constants and series for LOG(n)
E25F                    LAB_25A0
E25F  02                	.byte	$02			; counter
E260  80195662          	.byte	$80,$19,$56,$62	; 0.59898
E264  807622F3          	.byte	$80,$76,$22,$F3	; 0.96147
                        ;##	.byte	$80,$76,$22,$F1	; 0.96147
E268  8238AA40          	.byte	$82,$38,$AA,$40	; 2.88539
                        ;##	.byte	$82,$38,$AA,$45	; 2.88539

E26C                    LAB_25AD
E26C  803504F3          	.byte	$80,$35,$04,$F3	; 0.70711	1/root 2
E270                    LAB_25B1
E270  813504F3          	.byte	$81,$35,$04,$F3	; 1.41421	root 2
E274                    LAB_25B5
E274  80800000          	.byte	$80,$80,$00,$00	; -0.5
E278                    LAB_25B9
E278  80317218          	.byte	$80,$31,$72,$18	; 0.69315	LOG(2)

                        					; numeric PRINT constants
E27C                    LAB_2947
E27C  91434FF8          	.byte	$91,$43,$4F,$F8	; 99999.9375 (max value with at least one decimal)
E280                    LAB_294B
E280  947423F7          	.byte	$94,$74,$23,$F7	; 999999.4375 (max value before scientific notation)
E284                    LAB_294F
E284  94742400          	.byte	$94,$74,$24,$00	; 1000000

                        					; EXP(n) constants and series
E288                    LAB_2AFA
E288  8138AA3B          	.byte	$81,$38,$AA,$3B	; 1.4427	(1/LOG base 2 e)
E28C                    LAB_2AFE
E28C  06                	.byte	$06			; counter
E28D  7463908C          	.byte	$74,$63,$90,$8C	; 2.17023e-4
E291  77230CAB          	.byte	$77,$23,$0C,$AB	; 0.00124
E295  7A1E9400          	.byte	$7A,$1E,$94,$00	; 0.00968
E299  7C634280          	.byte	$7C,$63,$42,$80	; 0.05548
E29D  7E75FED0          	.byte	$7E,$75,$FE,$D0	; 0.24023
E2A1  80317215          	.byte	$80,$31,$72,$15	; 0.69315
E2A5  81000000          	.byte	$81,$00,$00,$00	; 1.00000

                        ;##	.byte	$07			; counter
                        ;##	.byte	$74,$94,$2E,$40	; -1/7! (-1/5040)
