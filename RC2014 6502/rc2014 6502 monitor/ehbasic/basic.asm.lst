CE0C  A5 B7             	LDA	FAC2_s		; get FAC2 sign (b7)
CE0E  09 7F             	ORA	#$7F			; set all non sign bits
CE10  25 B4             	AND	FAC2_1		; and FAC2 mantissa1 (AND in sign bit)
CE12  85 B4             	STA	FAC2_1		; save FAC2 mantissa1
CE14  A9 B3             	LDA	#<FAC2_e		; set pointer low byte to FAC2
CE16  A0 00             	LDY	#>FAC2_e		; set pointer high byte to FAC2
CE18  20 28DA           	JSR	LAB_27F8		; compare FAC1 with FAC2 (AY)
CE1B  AA                	TAX				; copy result
CE1C  4C 50CE           	JMP	LAB_1CE1		; go evaluate result

                        					; do string < compare
CE1F                    LAB_1CAE
CE1F  46 5F             	LSR	Dtypef		; clear data type flag, $FF=string, $00=numeric
CE21  C6 9B             	DEC	comp_f		; clear < bit in compare function flag
CE23  20 4FD4           	JSR	LAB_22B6		; pop string off descriptor stack, or from top of string
                        					; space returns with A = length, X=pointer low byte,
                        					; Y=pointer high byte
CE26  85 AC             	STA	str_ln		; save length
CE28  86 AD             	STX	str_pl		; save string pointer low byte
CE2A  84 AE             	STY	str_ph		; save string pointer high byte
CE2C  A5 B5             	LDA	FAC2_2		; get descriptor pointer low byte
CE2E  A4 B6             	LDY	FAC2_3		; get descriptor pointer high byte
CE30  20 53D4           	JSR	LAB_22BA		; pop (YA) descriptor off stack or from top of string space
                        					; returns with A = length, X=pointer low byte,
                        					; Y=pointer high byte
CE33  86 B5             	STX	FAC2_2		; save string pointer low byte
CE35  84 B6             	STY	FAC2_3		; save string pointer high byte
CE37  AA                	TAX				; copy length
CE38  38                	SEC				; set carry for subtract
CE39  E5 AC             	SBC	str_ln		; subtract string 1 length
CE3B  F0 08             	BEQ	LAB_1CD6		; branch if str 1 length = string 2 length

CE3D  A9 01             	LDA	#$01			; set str 1 length > string 2 length
CE3F  90 04             	BCC	LAB_1CD6		; branch if so

CE41  A6 AC             	LDX	str_ln		; get string 1 length
CE43  A9 FF             	LDA	#$FF			; set str 1 length < string 2 length
CE45                    LAB_1CD6
CE45  85 B0             	STA	FAC1_s		; save length compare
CE47  A0 FF             	LDY	#$FF			; set index
CE49  E8                	INX				; adjust for loop
CE4A                    LAB_1CDB
CE4A  C8                	INY				; increment index
CE4B  CA                	DEX				; decrement count
CE4C  D0 07             	BNE	LAB_1CE6		; branch if still bytes to do

CE4E  A6 B0             	LDX	FAC1_s		; get length compare back
CE50                    LAB_1CE1
CE50  30 0F             	BMI	LAB_1CF2		; branch if str 1 < str 2

CE52  18                	CLC				; flag str 1 <= str 2
CE53  90 0C             	BCC	LAB_1CF2		; go evaluate result

CE55                    LAB_1CE6
CE55  B1 B5             	LDA	(FAC2_2),Y		; get string 2 byte
CE57  D1 AD             	CMP	(FAC1_1),Y		; compare with string 1 byte
CE59  F0 EF             	BEQ	LAB_1CDB		; loop if bytes =

CE5B  A2 FF             	LDX	#$FF			; set str 1 < string 2
CE5D  B0 02             	BCS	LAB_1CF2		; branch if so

CE5F  A2 01             	LDX	#$01			;  set str 1 > string 2
CE61                    LAB_1CF2
CE61  E8                	INX				; x = 0, 1 or 2
CE62  8A                	TXA				; copy to A
CE63  2A                	ROL				; *2 (1, 2 or 4)
CE64  25 63             	AND	Cflag			; AND with comparison evaluation flag
CE66  F0 02             	BEQ	LAB_1CFB		; branch if 0 (compare is false)

CE68  A9 FF             	LDA	#$FF			; else set result true
CE6A                    LAB_1CFB
CE6A  4C 0BDA           	JMP	LAB_27DB		; save A as integer byte and return

CE6D                    LAB_1CFE
CE6D  20 0FCD           	JSR	LAB_1C01		; scan for ",", else do syntax error then warm start

