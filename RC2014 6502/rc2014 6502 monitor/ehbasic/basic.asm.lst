DFAD                    LAB_CBIN
DFAD  20 BC00           	JSR	LAB_IGBY		; increment and scan memory
DFB0  49 30             	EOR	#'0'			; convert "0" to 0 etc.
DFB2  C9 02             	CMP	#$02			; compare with max+1
DFB4  90 E6             	BCC	LAB_NXCH		; branch exit if < 2

DFB6                    LAB_EXCH
DFB6  4C 3BDB           	JMP	LAB_28F6		; evaluate -ve flag and return

                        ; ctrl-c check routine. includes limited "life" byte save for INGET routine
                        ; now also the code that checks to see if an interrupt has occurred

DFB9                    CTRLC
DFB9  AD 0002           	LDA	ccflag		; get [CTRL-C] check flag
DFBC  D0 18             	BNE	LAB_FBA2		; exit if inhibited

DFBE  20 F1E1           	JSR	V_INPT		; scan input device
DFC1  90 0B             	BCC	LAB_FBA0		; exit if buffer empty

DFC3  8D 0102           	STA	ccbyte		; save received byte
DFC6  A2 20             	LDX	#$20			; "life" timer for bytes
DFC8  8E 0202           	STX	ccnull		; set countdown
DFCB  4C 28C6           	JMP	LAB_1636		; return to BASIC

DFCE                    LAB_FBA0
DFCE  AE 0202           	LDX	ccnull		; get countdown byte
DFD1  F0 03             	BEQ	LAB_FBA2		; exit if finished

DFD3  CE 0202           	DEC	ccnull		; else decrement countdown
DFD6                    LAB_FBA2
