DFD9  10 FB             	BPL	LAB_CRTS		; branch if interrupt not enabled

                        ; we disable the interrupt here and make two new commands RETIRQ and RETNMI to
                        ; automatically enable the interrupt when we exit

DFDB  0A                	ASL				; move happened bit to setup bit
DFDC  29 40             	AND	#$40			; mask happened bits
DFDE  F0 F6             	BEQ	LAB_CRTS		; if no interrupt then exit

DFE0  95 00             	STA	PLUS_0,X		; save interrupt flag byte

DFE2  8A                	TXA				; copy index ..
DFE3  A8                	TAY				; .. to Y

DFE4  68                	PLA				; dump return address low byte, call from CTRL-C
DFE5  68                	PLA				; dump return address high byte

DFE6  A9 05             	LDA	#$05			; need 5 bytes for GOSUB
DFE8  20 09C2           	JSR	LAB_1212		; check room on stack for A bytes
DFEB  A5 C4             	LDA	Bpntrh		; get BASIC execute pointer high byte
DFED  48                	PHA				; push on stack
DFEE  A5 C3             	LDA	Bpntrl		; get BASIC execute pointer low byte
DFF0  48                	PHA				; push on stack
DFF1  A5 88             	LDA	Clineh		; get current line high byte
DFF3  48                	PHA				; push on stack
DFF4  A5 87             	LDA	Clinel		; get current line low byte
DFF6  48                	PHA				; push on stack
DFF7  A9 8D             	LDA	#TK_GOSUB		; token for GOSUB
DFF9  48                	PHA				; push on stack

DFFA  B9 0100           	LDA	PLUS_1,Y		; get interrupt code pointer low byte
DFFD  85 C3             	STA	Bpntrl		; save as BASIC execute pointer low byte
DFFF  B9 0200           	LDA	PLUS_2,Y		; get interrupt code pointer high byte
E002  85 C4             	STA	Bpntrh		; save as BASIC execute pointer high byte

E004  4C CDC5           	JMP	LAB_15C2		; go do interpreter inner loop
