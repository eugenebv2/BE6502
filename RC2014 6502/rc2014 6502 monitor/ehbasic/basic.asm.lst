CEBB                    LAB_GVAR
CEBB  A2 00             	LDX	#$00			; set DIM flag = $00
CEBD  20 C200           	JSR	LAB_GBYT		; scan memory (1st character)
CEC0                    LAB_1D10
CEC0  86 5E             	STX	Defdim		; save DIM flag
CEC2                    LAB_1D12
CEC2  85 93             	STA	Varnm1		; save 1st character
CEC4  29 7F             	AND	#$7F			; clear FN flag bit
CEC6  20 2FCF           	JSR	LAB_CASC		; check byte, return C=0 if<"A" or >"Z"
CEC9  B0 03             	BCS	LAB_1D1F		; branch if ok

CECB  4C 13CD           	JMP	LAB_SNER		; else syntax error then warm start

