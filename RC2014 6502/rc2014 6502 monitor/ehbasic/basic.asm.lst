CD9D                    LAB_BHSS
CD9D  20 FACB           	JSR	LAB_EVEZ		; process expression
CDA0  20 E1CB           	JSR	LAB_CTNM		; check if source is numeric, else do type mismatch
CDA3  A5 AC             	LDA	FAC1_e		; get FAC1 exponent
CDA5  C9 98             	CMP	#$98			; compare with exponent = 2^24
CDA7  B0 20             	BCS	LAB_BHER		; branch if n>=2^24 (is too big)

CDA9  20 61DA           	JSR	LAB_2831		; convert FAC1 floating-to-fixed
CDAC  A2 02             	LDX	#$02			; 3 bytes to do
CDAE                    LAB_CFAC
CDAE  B5 AD             	LDA	FAC1_1,X		; get byte from FAC1
CDB0  95 11             	STA	nums_1,X		; save byte to temp
CDB2  CA                	DEX				; decrement index
CDB3  10 F9             	BPL	LAB_CFAC		; copy FAC1 mantissa to temp

CDB5  20 C200           	JSR	LAB_GBYT		; get next BASIC byte
CDB8  A2 00             	LDX	#$00			; set default to no leading "0"s
CDBA  C9 29             	CMP	#')'			; compare with close bracket
CDBC  F0 0A             	BEQ	LAB_1C54		; if ")" go do rest of function

CDBE  20 EFD5           	JSR	LAB_SCGB		; scan for "," and get byte
CDC1  20 C200           	JSR	LAB_GBYT		; get last byte back
CDC4  C9 29             	CMP	#')'			; is next character )
CDC6  D0 01             	BNE	LAB_BHER		; if not ")" go do error

CDC8                    LAB_1C54
CDC8  60                	RTS				; else do function

CDC9                    LAB_BHER
CDC9  4C 3AD0           	JMP	LAB_FCER		; do function call error then warm start

                        ; perform EOR

                        ; added operator format is the same as AND or OR, precedence is the same as OR

                        ; this bit worked first time but it took a while to sort out the operator table
                        ; pointers and offsets afterwards!

CDCC                    LAB_EOR
CDCC  20 F3CD           	JSR	GetFirst		; get first integer expression (no sign check)
CDCF  45 5B             	EOR	XOAw_l		; EOR with expression 1 low byte
CDD1  A8                	TAY				; save in Y
CDD2  A5 AE             	LDA	FAC1_2		; get FAC1 mantissa2
CDD4  45 5C             	EOR	XOAw_h		; EOR with expression 1 high byte
CDD6  4C 6AD1           	JMP	LAB_AYFC		; save and convert integer AY to FAC1 and return

                        ; perform OR

CDD9                    LAB_OR
CDD9  20 F3CD           	JSR	GetFirst		; get first integer expression (no sign check)
CDDC  05 5B             	ORA	XOAw_l		; OR with expression 1 low byte
CDDE  A8                	TAY				; save in Y
CDDF  A5 AE             	LDA	FAC1_2		; get FAC1 mantissa2
CDE1  05 5C             	ORA	XOAw_h		; OR with expression 1 high byte
CDE3  4C 6AD1           	JMP	LAB_AYFC		; save and convert integer AY to FAC1 and return

                        ; perform AND

CDE6                    LAB_AND
CDE6  20 F3CD           	JSR	GetFirst		; get first integer expression (no sign check)
CDE9  25 5B             	AND	XOAw_l		; AND with expression 1 low byte
CDEB  A8                	TAY				; save in Y
CDEC  A5 AE             	LDA	FAC1_2		; get FAC1 mantissa2
CDEE  25 5C             	AND	XOAw_h		; AND with expression 1 high byte
CDF0  4C 6AD1           	JMP	LAB_AYFC		; save and convert integer AY to FAC1 and return

                        ; get first value for OR, AND or EOR

CDF3                    GetFirst
CDF3  20 B7CF           	JSR	LAB_EVIR		; evaluate integer expression (no sign check)
CDF6  A5 AE             	LDA	FAC1_2		; get FAC1 mantissa2
CDF8  85 5C             	STA	XOAw_h		; save it
CDFA  A5 AF             	LDA	FAC1_3		; get FAC1 mantissa3
CDFC  85 5B             	STA	XOAw_l		; save it
CDFE  20 D4D6           	JSR	LAB_279B		; copy FAC2 to FAC1 (get 2nd value in expression)
CE01  20 B7CF           	JSR	LAB_EVIR		; evaluate integer expression (no sign check)
CE04  A5 AF             	LDA	FAC1_3		; get FAC1 mantissa3
CE06                    LAB_1C95
CE06  60                	RTS

