CF58  A4 80             	LDY	Earryh		; get array mem end high byte
CF5A  85 A6             	STA	Obendl		; save old block end low byte
CF5C  84 A7             	STY	Obendh		; save old block end high byte
CF5E  18                	CLC				; clear carry for add
CF5F  69 06             	ADC	#$06			; +6 (space for one var)
CF61  90 01             	BCC	LAB_1DAE		; branch if no overflow to high byte

CF63  C8                	INY				; else increment high byte
CF64                    LAB_1DAE
CF64  85 A4             	STA	Nbendl		; set new block end low byte
CF66  84 A5             	STY	Nbendh		; set new block end high byte
CF68  20 C7C1           	JSR	LAB_11CF		; open up space in memory
CF6B  A5 A4             	LDA	Nbendl		; get new start low byte
CF6D  A4 A5             	LDY	Nbendh		; get new start high byte (-$100)
CF6F  C8                	INY				; correct high byte
CF70  85 7D             	STA	Sarryl		; save new var mem end low byte
CF72  84 7E             	STY	Sarryh		; save new var mem end high byte
CF74  A0 00             	LDY	#$00			; clear index
CF76  A5 93             	LDA	Varnm1		; get var name 1st character
CF78  91 AA             	STA	(Vrschl),Y		; save var name 1st character
CF7A  C8                	INY				; increment index
CF7B  A5 94             	LDA	Varnm2		; get var name 2nd character
CF7D  91 AA             	STA	(Vrschl),Y		; save var name 2nd character
CF7F  A9 00             	LDA	#$00			; clear A
CF81  C8                	INY				; increment index
CF82  91 AA             	STA	(Vrschl),Y		; initialise var byte
CF84  C8                	INY				; increment index
CF85  91 AA             	STA	(Vrschl),Y		; initialise var byte
CF87  C8                	INY				; increment index
CF88  91 AA             	STA	(Vrschl),Y		; initialise var byte
CF8A  C8                	INY				; increment index
CF8B  91 AA             	STA	(Vrschl),Y		; initialise var byte

                        					; found a match for var ((Vrschl) = ptr)
CF8D                    LAB_1DD7
CF8D  A5 AA             	LDA	Vrschl		; get var address low byte
CF8F  18                	CLC				; clear carry for add
CF90  69 02             	ADC	#$02			; +2 (offset past var name bytes)
CF92  A4 AB             	LDY	Vrschh		; get var address high byte
CF94  90 01             	BCC	LAB_1DE1		; branch if no overflow from add

CF96  C8                	INY				; else increment high byte
CF97                    LAB_1DE1
CF97  85 95             	STA	Cvaral		; save current var address low byte
CF99  84 96             	STY	Cvarah		; save current var address high byte
CF9B  60                	RTS

                        ; set-up array pointer (Adatal/h) to first element in array
                        ; set Adatal,Adatah to Astrtl,Astrth+2*Dimcnt+#$05

CF9C                    LAB_1DE6
CF9C  A5 5D             	LDA	Dimcnt		; get # of dimensions (1, 2 or 3)
CF9E  0A                	ASL				; *2 (also clears the carry !)
CF9F  69 05             	ADC	#$05			; +5 (result is 7, 9 or 11 here)
CFA1  65 AA             	ADC	Astrtl		; add array start pointer low byte
CFA3  A4 AB             	LDY	Astrth		; get array pointer high byte
CFA5  90 01             	BCC	LAB_1DF2		; branch if no overflow

CFA7  C8                	INY				; else increment high byte
CFA8                    LAB_1DF2
CFA8  85 A4             	STA	Adatal		; save array data pointer low byte
CFAA  84 A5             	STY	Adatah		; save array data pointer high byte
CFAC  60                	RTS

                        ; evaluate integer expression

CFAD                    LAB_EVIN
CFAD  20 BC00           	JSR	LAB_IGBY		; increment and scan memory
CFB0  20 DECB           	JSR	LAB_EVNM		; evaluate expression and check is numeric,
                        					; else do type mismatch

                        ; evaluate integer expression (no check)

CFB3                    LAB_EVPI
CFB3  A5 B0             	LDA	FAC1_s		; get FAC1 sign (b7)
CFB5  30 0D             	BMI	LAB_1E12		; do function call error if -ve

                        ; evaluate integer expression (no sign check)

CFB7                    LAB_EVIR
CFB7  A5 AC             	LDA	FAC1_e		; get FAC1 exponent
CFB9  C9 90             	CMP	#$90			; compare with exponent = 2^16 (n>2^15)
CFBB  90 09             	BCC	LAB_1E14		; branch if n<2^16 (is ok)

CFBD  A9 EB             	LDA	#<LAB_1DF7		; set pointer low byte to -32768
CFBF  A0 E2             	LDY	#>LAB_1DF7		; set pointer high byte to -32768
CFC1  20 28DA           	JSR	LAB_27F8		; compare FAC1 with (AY)
CFC4                    LAB_1E12
CFC4  D0 74             	BNE	LAB_FCER		; if <> do function call error then warm start

CFC6                    LAB_1E14
CFC6  4C 61DA           	JMP	LAB_2831		; convert FAC1 floating-to-fixed and return

                        ; find or make array

CFC9                    LAB_1E17
CFC9  A5 5E             	LDA	Defdim		; get DIM flag
CFCB  48                	PHA				; push it
CFCC  A5 5F             	LDA	Dtypef		; get data type flag, $FF=string, $00=numeric
CFCE  48                	PHA				; push it
CFCF  A0 00             	LDY	#$00			; clear dimensions count

                        ; now get the array dimension(s) and stack it (them) before the data type and DIM flag

CFD1                    LAB_1E1F
CFD1  98                	TYA				; copy dimensions count
CFD2  48                	PHA				; save it
CFD3  A5 94             	LDA	Varnm2		; get array name 2nd byte
CFD5  48                	PHA				; save it
CFD6  A5 93             	LDA	Varnm1		; get array name 1st byte
CFD8  48                	PHA				; save it
CFD9  20 ADCF           	JSR	LAB_EVIN		; evaluate integer expression
CFDC  68                	PLA				; pull array name 1st byte
CFDD  85 93             	STA	Varnm1		; restore array name 1st byte
CFDF  68                	PLA				; pull array name 2nd byte
CFE0  85 94             	STA	Varnm2		; restore array name 2nd byte
CFE2  68                	PLA				; pull dimensions count
CFE3  A8                	TAY				; restore it
CFE4  BA                	TSX				; copy stack pointer
CFE5  BD 0201           	LDA	LAB_STAK+2,X	; get DIM flag
CFE8  48                	PHA				; push it
CFE9  BD 0101           	LDA	LAB_STAK+1,X	; get data type flag
CFEC  48                	PHA				; push it
CFED  A5 AE             	LDA	FAC1_2		; get this dimension size high byte
CFEF  9D 0201           	STA	LAB_STAK+2,X	; stack before flag bytes
CFF2  A5 AF             	LDA	FAC1_3		; get this dimension size low byte
CFF4  9D 0101           	STA	LAB_STAK+1,X	; stack before flag bytes
CFF7  C8                	INY				; increment dimensions count
CFF8  20 C200           	JSR	LAB_GBYT		; scan memory
CFFB  C9 2C             	CMP	#','			; compare with ","
CFFD  F0 D2             	BEQ	LAB_1E1F		; if found go do next dimension

CFFF  84 5D             	STY	Dimcnt		; store dimensions count
D001  20 00CD           	JSR	LAB_1BFB		; scan for ")" , else do syntax error then warm start
D004  68                	PLA				; pull data type flag
D005  85 5F             	STA	Dtypef		; restore data type flag, $FF=string, $00=numeric
D007  68                	PLA				; pull DIM flag
D008  85 5E             	STA	Defdim		; restore DIM flag
D00A  A6 7D             	LDX	Sarryl		; get array mem start low byte
D00C  A5 7E             	LDA	Sarryh		; get array mem start high byte

                        ; now check to see if we are at the end of array memory (we would be if there were
                        ; no arrays).

D00E                    LAB_1E5C
D00E  86 AA             	STX	Astrtl		; save as array start pointer low byte
D010  85 AB             	STA	Astrth		; save as array start pointer high byte
D012  C5 80             	CMP	Earryh		; compare with array mem end high byte
D014  D0 04             	BNE	LAB_1E68		; branch if not reached array mem end

D016  E4 7F             	CPX	Earryl		; else compare with array mem end low byte
D018  F0 39             	BEQ	LAB_1EA1		; go build array if not found

                        					; search for array
D01A                    LAB_1E68
D01A  A0 00             	LDY	#$00			; clear index
D01C  B1 AA             	LDA	(Astrtl),Y		; get array name first byte
D01E  C8                	INY				; increment index to second name byte
D01F  C5 93             	CMP	Varnm1		; compare with this array name first byte
D021  D0 06             	BNE	LAB_1E77		; branch if no match

D023  A5 94             	LDA	Varnm2		; else get this array name second byte
D025  D1 AA             	CMP	(Astrtl),Y		; compare with array name second byte
D027  F0 16             	BEQ	LAB_1E8D		; array found so branch

                        					; no match
D029                    LAB_1E77
D029  C8                	INY				; increment index
D02A  B1 AA             	LDA	(Astrtl),Y		; get array size low byte
D02C  18                	CLC				; clear carry for add
D02D  65 AA             	ADC	Astrtl		; add array start pointer low byte
D02F  AA                	TAX				; copy low byte to X
D030  C8                	INY				; increment index
D031  B1 AA             	LDA	(Astrtl),Y		; get array size high byte
D033  65 AB             	ADC	Astrth		; add array mem pointer high byte
D035  90 D7             	BCC	LAB_1E5C		; if no overflow go check next array

                        ; do array bounds error

D037                    LAB_1E85
D037  A2 10             	LDX	#$10			; error code $10 ("Array bounds" error)
D039  2C                	.byte	$2C			; makes next bit BIT LAB_08A2

                        ; do function call error

D03A                    LAB_FCER
D03A  A2 08             	LDX	#$08			; error code $08 ("Function call" error)
D03C                    LAB_1E8A
D03C  4C 42C2           	JMP	LAB_XERR		; do error #X, then warm start

                        					; found array, are we trying to dimension it?
D03F                    LAB_1E8D
D03F  A2 12             	LDX	#$12			; set error $12 ("Double dimension" error)
D041  A5 5E             	LDA	Defdim		; get DIM flag
D043  D0 F7             	BNE	LAB_1E8A		; if we are trying to dimension it do error #X, then warm
                        					; start

