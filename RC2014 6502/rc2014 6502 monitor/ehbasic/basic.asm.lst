D094  B0 5D             	BCS	LAB_1F45		; if overflow go do "Out of memory" error

D096  85 A5             	STA	Adatah		; save end of array high byte
D098  A8                	TAY				; copy end high byte to Y
D099  8A                	TXA				; get array size low byte
D09A  65 A4             	ADC	Adatal		; add array start low byte
D09C  90 03             	BCC	LAB_1EF3		; branch if no carry

D09E  C8                	INY				; else increment end of array high byte
D09F  F0 52             	BEQ	LAB_1F45		; if overflow go do "Out of memory" error

