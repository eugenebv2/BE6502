DF63  29 0F             	AND	#$0F			; mask off top bits
DF65  20 6DDF           	JSR	LAB_AL2X		; convert low nibble to ASCII and output
DF68  8A                	TXA				; get byte back
DF69  4A                	LSR				; /2	shift high nibble to low nibble
DF6A  4A                	LSR				; /4
DF6B  4A                	LSR				; /8
DF6C  4A                	LSR				; /16
DF6D                    LAB_AL2X
