DE50  20 5ADE           	JSR	LAB_2C74		; save flag and go do series evaluation

DE53  A9 9C             	LDA	#<func_l		; set sin(n) pointer low byte
DE55  A0 00             	LDY	#>func_l		; set sin(n) pointer high byte
DE57  4C 12D9           	JMP	LAB_26CA		; convert AY and do (AY)/FAC1

DE5A                    LAB_2C74
DE5A  48                	PHA				; save comparison evaluation flag
DE5B  4C 1BDE           	JMP	LAB_2C35		; go do series evaluation

                        ; perform USR()

DE5E                    LAB_USR
DE5E  20 0A00           	JSR	Usrjmp		; call user code
DE61  4C 00CD           	JMP	LAB_1BFB		; scan for ")", else do syntax error then warm start

                        ; perform ATN()

DE64                    LAB_ATN
DE64  A5 B0             	LDA	FAC1_s		; get FAC1 sign (b7)
DE66  48                	PHA				; save sign
DE67  10 03             	BPL	LAB_2CA1		; branch if +ve

DE69  20 05DD           	JSR	LAB_GTHAN		; else do - FAC1
DE6C                    LAB_2CA1
DE6C  A5 AC             	LDA	FAC1_e		; get FAC1 exponent
DE6E  48                	PHA				; push exponent
DE6F  C9 81             	CMP	#$81			; compare with 1
DE71  90 07             	BCC	LAB_2CAF		; branch if FAC1<1

DE73  A9 E3             	LDA	#<LAB_259C		; set 1 pointer low byte
DE75  A0 E2             	LDY	#>LAB_259C		; set 1 pointer high byte
DE77  20 12D9           	JSR	LAB_26CA		; convert AY and do (AY)/FAC1
DE7A                    LAB_2CAF
DE7A  A9 C2             	LDA	#<LAB_2CC9		; set pointer low byte to counter
DE7C  A0 E2             	LDY	#>LAB_2CC9		; set pointer high byte to counter
DE7E  20 62DD           	JSR	LAB_2B6E		; ^2 then series evaluation
DE81  68                	PLA				; restore old FAC1 exponent
DE82  C9 81             	CMP	#$81			; compare with 1
DE84  90 07             	BCC	LAB_2CC2		; branch if FAC1<1

DE86  A9 A9             	LDA	#<LAB_2C78		; set (pi/2) pointer low byte
DE88  A0 E2             	LDY	#>LAB_2C78		; set (pi/2) pointer high byte
DE8A  20 B4D6           	JSR	LAB_2455		; perform subtraction, (AY) from FAC1
DE8D                    LAB_2CC2
