CE70                    LAB_DIM
CE70  AA                	TAX				; copy "DIM" flag to X
CE71  20 C0CE           	JSR	LAB_1D10		; search for variable
CE74  20 C200           	JSR	LAB_GBYT		; scan memory
CE77  D0 F4             	BNE	LAB_1CFE		; scan for "," and loop if not null

CE79  60                	RTS

