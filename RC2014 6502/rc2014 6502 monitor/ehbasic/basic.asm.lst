                        ; returns with carry set if byte in A

E007                    INGET
E007  20 F1E1           	JSR	V_INPT		; call scan input device
E00A  B0 09             	BCS	LAB_FB95		; if byte go reset timer

E00C  AD 0202           	LDA	ccnull		; get countdown
E00F  F0 09             	BEQ	LAB_FB96		; exit if empty

E011  AD 0102           	LDA	ccbyte		; get last received byte
E014  38                	SEC				; flag we got a byte
E015                    LAB_FB95
E015  A2 00             	LDX	#$00			; clear X
E017  8E 0202           	STX	ccnull		; clear timer because we got a byte
E01A                    LAB_FB96
E01A  60                	RTS

                        ; these routines only enable the interrupts if the set-up flag is set
                        ; if not they have no effect



                        ; perform IRQ {ON|OFF|CLEAR}
E01B                    LAB_IRQ
E01B  A2 DF             	LDX	#IrqBase		; set pointer to IRQ values
E01D  2C                	.byte	$2C			; make next line BIT abs.

                        ; perform NMI {ON|OFF|CLEAR}

E01E                    LAB_NMI
E01E  A2 DC             	LDX	#NmiBase		; set pointer to NMI values
E020  C9 93             	CMP	#TK_ON		; compare with token for ON
E022  F0 11             	BEQ	LAB_INON		; go turn on interrupt

E024  C9 B6             	CMP	#TK_OFF		; compare with token for OFF
E026  F0 07             	BEQ	LAB_IOFF		; go turn off interrupt

E028  49 A2             	EOR	#TK_CLEAR		; compare with token for CLEAR, A = $00 if = TK_CLEAR
E02A  F0 0E             	BEQ	LAB_INEX		; go clear interrupt flags and return

E02C  4C 13CD           	JMP	LAB_SNER		; do syntax error then warm start

E02F                    LAB_IOFF
