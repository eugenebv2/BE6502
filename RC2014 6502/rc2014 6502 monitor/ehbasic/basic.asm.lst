D045  20 9CCF           	JSR	LAB_1DE6		; set-up array pointer (Adatal/h) to first element in array
                        					; (Astrtl,Astrth points to start of array)
D048  A5 5D             	LDA	Dimcnt		; get dimensions count
D04A  A0 04             	LDY	#$04			; set index to array's # of dimensions
D04C  D1 AA             	CMP	(Astrtl),Y		; compare with no of dimensions
D04E  D0 E7             	BNE	LAB_1E85		; if wrong do array bounds error, could do "Wrong
                        					; dimensions" error here .. if we want a different
                        					; error message

D050  4C D6D0           	JMP	LAB_1F28		; found array so go get element
                        					; (could jump to LAB_1F28 as all LAB_1F24 does is take
                        					; Dimcnt and save it at (Astrtl),Y which is already the
                        					; same or we would have taken the BNE)

                        					; array not found, so build it
D053                    LAB_1EA1
D053  20 9CCF           	JSR	LAB_1DE6		; set-up array pointer (Adatal/h) to first element in array
                        					; (Astrtl,Astrth points to start of array)
D056  20 11C2           	JSR	LAB_121F		; check available memory, "Out of memory" error if no room
                        					; addr to check is in AY (low/high)
D059  A0 00             	LDY	#$00			; clear Y (don't need to clear A)
D05B  84 BB             	STY	Aspth			; clear array data size high byte
D05D  A5 93             	LDA	Varnm1		; get variable name 1st byte
D05F  91 AA             	STA	(Astrtl),Y		; save array name 1st byte
D061  C8                	INY				; increment index
D062  A5 94             	LDA	Varnm2		; get variable name 2nd byte
D064  91 AA             	STA	(Astrtl),Y		; save array name 2nd byte
D066  A5 5D             	LDA	Dimcnt		; get dimensions count
D068  A0 04             	LDY	#$04			; index to dimension count
D06A  84 BA             	STY	Asptl			; set array data size low byte (four bytes per element)
D06C  91 AA             	STA	(Astrtl),Y		; set array's dimensions count

                        					; now calculate the size of the data space for the array
D06E  18                	CLC				; clear carry for add (clear on subsequent loops)
D06F                    LAB_1EC0
D06F  A2 0B             	LDX	#$0B			; set default dimension value low byte
D071  A9 00             	LDA	#$00			; set default dimension value high byte
D073  24 5E             	BIT	Defdim		; test default DIM flag
D075  50 07             	BVC	LAB_1ED0		; branch if b6 of Defdim is clear

D077  68                	PLA				; else pull dimension value low byte
D078  69 01             	ADC	#$01			; +1 (allow for zeroeth element)
D07A  AA                	TAX				; copy low byte to X
D07B  68                	PLA				; pull dimension value high byte
D07C  69 00             	ADC	#$00			; add carry from low byte

D07E                    LAB_1ED0
D07E  C8                	INY				; index to dimension value high byte
D07F  91 AA             	STA	(Astrtl),Y		; save dimension value high byte
D081  C8                	INY				; index to dimension value high byte
D082  8A                	TXA				; get dimension value low byte
D083  91 AA             	STA	(Astrtl),Y		; save dimension value low byte
D085  20 25D1           	JSR	LAB_1F7C		; does XY = (Astrtl),Y * (Asptl)
D088  86 BA             	STX	Asptl			; save array data size low byte
D08A  85 BB             	STA	Aspth			; save array data size high byte
D08C  A4 71             	LDY	ut1_pl		; restore index (saved by subroutine)
D08E  C6 5D             	DEC	Dimcnt		; decrement dimensions count
D090  D0 DD             	BNE	LAB_1EC0		; loop while not = 0

D092  65 A5             	ADC	Adatah		; add size high byte to first element high byte
