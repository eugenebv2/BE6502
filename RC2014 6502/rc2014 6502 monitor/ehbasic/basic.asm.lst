E037  0A                	ASL				; Shift bit to enabled flag
E038  15 00             	ORA	PLUS_0,X		; OR with flag byte
E03A                    LAB_INEX
E03A  95 00             	STA	PLUS_0,X		; save interrupt flag byte
E03C  4C BC00           	JMP	LAB_IGBY		; update BASIC execute pointer and return

                        ; these routines set up the pointers and flags for the interrupt routines
                        ; note that the interrupts are also enabled by these commands

