CE7A                    LAB_LSHIFT
CE7A  20 B0CE           	JSR	GetPair		; get integer expression and byte (no sign check)
CE7D  A5 AE             	LDA	FAC1_2		; get expression high byte
CE7F  A6 78             	LDX	TempB			; get shift count
CE81  F0 22             	BEQ	NoShift		; branch if zero

CE83  E0 10             	CPX	#$10			; compare bit count with 16d
CE85  B0 23             	BCS	TooBig		; branch if >=

CE87                    Ls_loop
CE87  06 AF             	ASL	FAC1_3		; shift low byte
CE89  2A                	ROL				; shift high byte
CE8A  CA                	DEX				; decrement bit count
CE8B  D0 FA             	BNE	Ls_loop		; loop if shift not complete

CE8D  A4 AF             	LDY	FAC1_3		; get expression low byte
CE8F  4C 6AD1           	JMP	LAB_AYFC		; save and convert integer AY to FAC1 and return

                        ; perform >> (right shift)

CE92                    LAB_RSHIFT
CE92  20 B0CE           	JSR	GetPair		; get integer expression and byte (no sign check)
CE95  A5 AE             	LDA	FAC1_2		; get expression high byte
CE97  A6 78             	LDX	TempB			; get shift count
CE99  F0 0A             	BEQ	NoShift		; branch if zero

CE9B  E0 10             	CPX	#$10			; compare bit count with 16d
CE9D  B0 0B             	BCS	TooBig		; branch if >=

CE9F                    Rs_loop
CE9F  4A                	LSR				; shift high byte
CEA0  66 AF             	ROR	FAC1_3		; shift low byte
CEA2  CA                	DEX				; decrement bit count
CEA3  D0 FA             	BNE	Rs_loop		; loop if shift not complete

CEA5                    NoShift
