CF49  A9 E4             	LDA	#<LAB_1D96		; low byte point to $00,$00
                        					; (uses part of misc constants table)
CF4B  A0 E2             	LDY	#>LAB_1D96		; high byte point to $00,$00
CF4D  60                	RTS

