DF73  88                	DEY				; decrement counter
DF74  60                	RTS

DF75                    LAB_NLTO
DF75  85 AC             	STA	FAC1_e		; save FAC1 exponent
DF77  A9 00             	LDA	#$00			; clear sign compare
DF79                    LAB_MLTE
