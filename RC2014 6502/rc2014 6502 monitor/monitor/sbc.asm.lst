FC62  20646F6E 65
FC67  0D0A                              .byte   $0d, $0a
FC69  00                                .byte   $00	

                        ;---------------------------------------------------------------------

FC6A                    go_help
FC6A  A9 0D                     lda     #CR
FC6C  A2 FF                     ldx   #$ff              ; set txt pointer
FC6E                    gh_loop
FC6E  E8                        inx                     ;
FC6F  20 09FF                   jsr   Output_char            ; put character to Port
FC72  BD 75FB                   lda   helptxt,x         ; get message text
FC75  D0 F7                     bne   gh_loop      ;
FC77  AA                        tax             ; Init x = 0
FC78                    gh_loop2
FC78  BD 3AFC                   lda     helptxt2, x
FC7B  F0 06                     beq     gh_end
FC7D  20 09FF                   jsr     output_char
FC80  E8                        inx
FC81  D0 F5                     bne     gh_loop2
FC83                    gh_end
FC83  4C B6FA                   jmp     monitor_loop

                        ;---------------------------------------------------------------------
                        ; Display byte at an address
                        ; Change byte at the address
                        ; ENTER to go to next address
                        ; ESC to escape back to monitor
                        ; enter hex value to replace current value and skip to next address

FC86                    go_mem
FC86  A9 00                     lda     #$00
FC88  85 E1                     sta     Startaddr
FC8A  85 E2                     sta     Startaddr_H
FC8C  20 00FA                   jsr     print1sp        ; Space out
                                ; Get address
FC8F  20 2DFB                   jsr     get_word
FC92  90 04                     bcc     gm_0            ; All hex chars
FC94  C9 0D                     cmp     #$0d             ; Is the last char RETURN?
FC96  D0 65                     bne     gm_end          ; No, then quit
FC98                    gm_0
                        ;        cpy     #$00            ; Did we grab a whole word?
                        ;        bne     gm_end
                                ; Copy the word to the address pointer
FC98  A5 E3                     lda     Hexdigits
FC9A  85 E1                     sta     Startaddr
FC9C  A5 E4                     lda     Hexdigits_H
FC9E  85 E2                     sta     Startaddr_H
FCA0                    gm_loop0
FCA0  20 CDF9                   jsr     print_cr       ; Go to next line
FCA3                    gm_loop1
                                ; Print address
FCA3  A5 E2                     lda     Startaddr_H
FCA5  A6 E1                     ldx     Startaddr
FCA7  20 DAF9                   jsr     print2byte
FCAA  20 00FA                   jsr     print1sp        ; 1 Space
FCAD  A9 3A                     lda     #':'
FCAF  20 09FF                   jsr     output_char
FCB2  20 00FA                   jsr     print1sp
                                ; Print byte at address
FCB5  A0 00                     ldy     #$00
FCB7  B1 E1                     lda     (Startaddr), y  ; get byte at address
FCB9  20 DEF9                   jsr     Print1Byte      ; Print byte
FCBC  20 00FA                   jsr     print1sp
                                ; Grab command
                                ; Next is either ESC (quit), ENTER (next) or HEX value
FCBF                    gm_loop
                                ; Init hex buffer first
FCBF  A9 00                     lda     #$00
FCC1  85 E3                     sta     Hexdigits
FCC3  85 E4                     sta     Hexdigits_H
                                ; Get command or hex
FCC5  20 03FF                   jsr     input_char       ; Get a char
FCC8  C9 1B                     cmp     #27             ; ESC
FCCA  F0 31                     beq      gm_end         ; ESC so abort
FCCC  C9 0D                     cmp     #$0d            ; ENTER
FCCE  D0 09                     bne     gm_not_enter    ; Not ENTER, data entry mode?
                                ;
                                ; ENTER, increment Startaddr to next memory address
                                ;
FCD0                    gm_next_address
FCD0  E6 E1                     inc     Startaddr
FCD2  D0 02                     bne     gm_inc_done
FCD4  E6 E2                     inc     Startaddr_H
FCD6                    gm_inc_done
FCD6  4C A0FC                   jmp     gm_loop0        ; Get next byte and display it

                                ; Check if hex
                                ; A=first character
FCD9                    gm_not_enter
FCD9  A8                        tay                     ; Save char
                                ; Char in A
FCDA  20 56FB                   jsr     check_hex_char
FCDD  B0 C1                     bcs     gm_loop0        ; Not hex, reprint line
FCDF  48                        pha                     ; Save hex value
FCE0  98                        tya                     ; Get original char
FCE1  20 09FF                   jsr     output_char          ; Echo it
FCE4  68                        pla                     ; Restore hex value
FCE5  A0 02                     ldy     #$02
FCE7  20 3AFB                   jsr     build_byte      ; Get the full byte
FCEA  C0 00                     cpy     #$00            ; Are we done?
FCEC  D0 B2                     bne     gm_loop0
FCEE  91 E1                     sta     (Startaddr), y  ; Store byte at address
FCF0  20 00FA                   jsr     print1sp        ; Print space
FCF3  A0 00                     ldy     #$00
FCF5  B1 E1                     lda     (Startaddr), y  ; get byte at address
FCF7  20 DEF9                   jsr     Print1Byte      ; Print byte at address
FCFA  4C D0FC                   jmp     gm_next_address ; Next

FCFD                    gm_end
FCFD  4C B6FA                   jmp     monitor_loop


                        ;---------------------------------------------------------------------

FD00                    go_dump
FD00                    dump_mem
FD00  A9 00                     lda     #$00
FD02  85 E1                     sta     Startaddr
FD04  85 E2                     sta     Startaddr_H
FD06  20 00FA                   jsr     print1sp        ; Space out
                                ; Get address
FD09  20 2DFB                   jsr     get_word
FD0C  90 04                     bcc     dm_0            ; All hex chars
FD0E  C9 0D                     cmp     #$0d             ; Is the last char RETURN?
FD10  D0 6A                     bne     dm_end          ; No, then quit
FD12                    dm_0
                        ;        cpy     #$00            ; Did we grab a whole word?
                        ;        bne     dm_end
                                ; Copy the word to the address pointer
FD12  A5 E3                     lda     Hexdigits
FD14  85 E1                     sta     Startaddr
FD16  A5 E4                     lda     Hexdigits_H
FD18  85 E2                     sta     Startaddr_H
FD1A                    dm_loopx
FD1A  A9 10                     lda     #16
FD1C  8D EB03                   sta     rowcount
FD1F                    dm_loop0
FD1F  20 CDF9                   jsr     print_cr       ; Go to next line
FD22                    dm_loop1
                                ; Print address
FD22  A5 E2                     lda     Startaddr_H
FD24  A6 E1                     ldx     Startaddr
FD26  20 DAF9                   jsr     print2byte
FD29  20 FDF9                   jsr     print2sp        ; 1 Space
                                ; Read 16 bytes
FD2C  A0 00                     ldy     #$00
FD2E  A2 10                     ldx     #$10
FD30                    dm_loop2
FD30  B1 E1                     lda     (Startaddr), y
FD32  20 DEF9                   jsr     print1byte
FD35  20 00FA                   jsr     print1sp
FD38  C8                        iny
FD39  CA                        dex
FD3A  D0 F4                     bne     dm_loop2
                                ; Next section
FD3C  A9 3B                     lda     #';'
FD3E  20 09FF                   jsr    output_char
FD41  20 00FA                   jsr     print1sp
FD44  A0 00                     ldy     #$00
FD46  A2 10                     ldx     #$10
FD48                    dm_loop3
FD48  B1 E1                     lda     (Startaddr), y  ; Get byte
FD4A  C9 20                     cmp     #32             ; Control character?
FD4C  90 0A                     bcc     not_printable    ; not printable
FD4E  C9 7F                     cmp     #127            ; non-ascii characters?
FD50  B0 06                     bcs     not_printable
FD52                    dm_xx
FD52  20 09FF                   jsr     output_char     ; Print character
FD55  4C 5DFD                   jmp     dm_next0
FD58                    not_printable
FD58  A9 2E                     lda     #'.'            ; Print . instead
FD5A  4C 52FD                   jmp     dm_xx
FD5D                    dm_next0                        ; Incrememt address pointer
FD5D  E6 E1                     inc     startaddr
FD5F  D0 02                     bne     dm_next1
FD61  E6 E2                     inc     startaddr_h
FD63                    dm_next1                        ; Have we done 16 bytes?
FD63  CA                        dex
FD64  D0 E2                     bne     dm_loop3        ; Reloop if not
FD66  20 CDF9                   jsr     print_cr        ; Go to next row
FD69  CE EB03                   dec     rowcount        ; Have we done 16 rows?
FD6C  D0 B4                     bne     dm_loop1        ; Next row if not
FD6E  A9 FD                     lda	#>dm_prompt     ; Print prompt
FD70  A2 7F             	ldx	#<dm_prompt
FD72  20 0CFF           	jsr     $ff0c
FD75  20 03FF           	jsr     input_char      ; Get user input
FD78  C9 1B             	cmp     #27             ; Escape?
FD7A  D0 9E             	bne     dm_loopx        ; Next 16 lines
FD7C                    dm_end
FD7C  4C B6FA                   jmp     monitor_loop

FD7F  50726573 7320616E dm_prompt       .byte	"Press any key to continue, ESC to quit",0
