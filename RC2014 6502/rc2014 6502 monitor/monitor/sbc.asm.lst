FC2E  656C2048 45582066
FC36  696C6500
FC3A                    helptxt2:
FC3A  0D0A2020 20202020 		.byte   CR,LF,"            ESC to quit when upload is done"
FC42  20202020 20204553
FC4A  4320746F 20717569
FC52  74207768 656E2075
