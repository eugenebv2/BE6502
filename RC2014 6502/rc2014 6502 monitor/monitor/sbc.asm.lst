                                ; -----------------------------
                                ; Only this file defines absolute addresses
FDE1                    	.include reset.asm         ; Reset & IRQ handler
                        ;---------------------------------------------------------------------
                        ; Modified for RC2014
                        ; Changes are copyright Ben Chong and freely licensed to the community
                        ;
                        ;****************************************************************************
                        ; Reset, Interrupt, & Break Handlers
                        ;****************************************************************************
                                ; Put this in the last page of ROM
FF00                            .org    $ff00

                        ; Vector table

                                ; Monitor vector $ff00
FF00  4C B3FA                           jmp     Monitor

FF03                            .org $ff03
FF03  6C D003           input_char      jmp     (uart_input_vecl)       ; wait for input character
                                ; $ff06
FF06  6C D203           check_input     jmp     (uart_scan_vecl)        ; scan for input (no wait), C=1 char, C=0 no character
                                ; $ff09
FF09  6C D403           output_char     jmp     (uart_output_vecl)      ; send 1 character
                                ; $ff0c
FF0C  4C 05FA           printstring     jmp     PrintStrAX

                        ;--------------Reset handler----------------------------------------------

FF0F  78                reset          sei                     ; diable interupts
FF10  D8                               cld                     ; clear decimal mode
FF11  A2 FF                            ldx      #$FF              ;
FF13  9A                               txs                     ; init stack pointer

                                        ; Initialize interrupt vectors
                                        ; Use null_irq and similar NMI handlers first
FF14  A9 FF                             lda     #>null_irq
FF16  A2 5B                             ldx     #<null_irq
FF18  8E E803                           stx      irq_vector
FF1B  8D E903                           sta      irq_vector+1
FF1E  A9 FF                             lda     #>nmi_handler
FF20  A2 5E                             ldx     #<nmi_handler
FF22  8E EA03                           stx      nmi_vector
FF25  8D EB03                           sta      nmi_vector+1
                                        ; Init the I/O devices
                                        ; At this point, the actual IRQ handling may be set up
FF28  20 31F9                           jsr     uart_init	

                                        ; Set up default handlers
FF2B  A9 F9                             lda     #>uart_input
FF2D  A2 41                             ldx     #<uart_input
FF2F  8E D003                           stx      uart_input_vecl
FF32  8D D103                           sta      uart_input_vech
FF35  A9 F9                             lda     #>uart_scan
FF37  A2 4C                             ldx     #<uart_scan
FF39  8E D203                           stx      uart_scan_vecl
FF3C  8D D303                           sta      uart_scan_vech
FF3F  A9 F9                             lda     #>uart_output
FF41  A2 59                             ldx     #<uart_output
FF43  8E D403                           stx      uart_output_vecl
FF46  8D D503                           sta      uart_output_vech

FF49  58                               cli                      ; Enable interrupt
FF4A  4C B0FA                          jmp      MonitorBoot     ; Monitor for cold reset

                        ; -------------------------------------
                        ; Interrupt or BRK entry point
FF4D                    irqbrkhandler
FF4D  48                                PHA                     ; Save A
FF4E  8A                                TXA  	                ;
FF4F  48                                PHA                     ; Save X
FF50  BA                                TSX                     ; get stack pointer
FF51  BD 0301                           LDA     $0103,X           ; load INT-P Reg off stack
FF54  29 10                             AND     #$10              ; mask BRK
FF56  D0 0A                             BNE     BrkCmd            ; BRK CMD
                                        ; Not BRK, so it must be a real interrupt
                                        ; The Interrupt handler needs to know that
                                        ; A and X are already on the stack
FF58  6C E803           irqjump         jmp     (irq_vector)    ; Jump to indirect handler

                                        ; Default IRQ handler, before we return, restore X and A
FF5B                    null_irq
FF5B  68                                pla                     ; Restore X
FF5C  AA                                tax                     ; 		
FF5D  68                                pla                     ; Restore A
                                        ; Then return from interrupt
FF5E                    nmi_handler
FF5E  40                                rti                     ; Null Interrupt return

                        ; -------------------------------------
                        ; NMI entry point
FF5F  6C EA03           nmijump         jmp     (nmi_vector)

                        ; -------------------------------------
                        ; BRK handler
                        ; We'll leave X and A on the stack and have the break handler deal with them
FF62                    BrkCmd
                        ;                pla                     ; X
                        ;                tax                     ;
                        ;                pla                     ; A
FF62  4C 1AFA                           jmp   BRKroutine        ; patch in user BRK routine

                        ;
                        ;  NMIjmp      =     $FFFA
                        ;  RESjmp      =     $FFFC
                        ;  INTjmp      =     $FFFE

FFFA                            .org    $fffa
FFFA  5FFF                             .word  nmijump
FFFC  0FFF                             .word  reset
FFFE  4DFF                             .word  irqbrkhandler
                        ;end of file

0000                    	.end
